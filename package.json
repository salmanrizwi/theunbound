{
  "name": "theunbound-dmc-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx server.ts",
    "build": "vite build && esbuild server/main.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node server.ts",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "tsx src/tests/masterSystemAuditCertification.ts",
    "test:all": "tsx src/tests/masterSystemAuditCertification.ts && tsx src/tests/masterPricingEngineAudit.ts && tsx src/tests/capacityTieredPricingInputAudit.ts && tsx src/tests/homepageDataSyncAudit.ts"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "firebase": "^12.18.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.13",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  }
}
