# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE WORKSPACE & GMAIL INTEGRATION (Server-side private secrets)
# Used by backend integration service for OAuth token refresh and Gmail/Sheets API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_WORKSPACE_EMAIL=
GOOGLE_SHEET_ID=

# GOOGLE FINANCE LIVE CURRENCY EXCHANGE RATE INTEGRATION
# Authoritative live FX rates provider for TheUnbound commercial pricing engine
# Note: Google Finance requires NO paid API subscription or private API keys.
GOOGLE_FINANCE_SYNC_ENABLED=true
