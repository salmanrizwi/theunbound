{
  "version": "1.0.0",
  "project": {
    "name": "TheUnbound DMC Platform",
    "description": "Comprehensive DMC Operating System connecting Products, Commercial Pricing, Quotes, Bookings, Operations, Finance, CRM, and Admin CMS"
  },
  "entities": {
    "User": {
      "collection": "users",
      "fields": {
        "id": { "type": "string", "required": true },
        "email": { "type": "string", "required": true },
        "displayName": { "type": "string", "required": true },
        "role": { "type": "string", "required": true, "enum": ["ADMIN", "TEAM_MEMBER", "BUYER", "B2B_AGENT"] },
        "userType": { "type": "string", "required": true, "enum": ["BUYER", "B2B_AGENT", "ADMIN", "TEAM_MEMBER"] },
        "status": { "type": "string", "required": true, "enum": ["Pending", "Approved", "Rejected", "Suspended", "Inactive"] },
        "agencyName": { "type": "string", "required": false },
        "gstNumber": { "type": "string", "required": false },
        "panNumber": { "type": "string", "required": false },
        "gstCertificateUrl": { "type": "string", "required": false },
        "panCardUrl": { "type": "string", "required": false },
        "businessType": { "type": "string", "required": false },
        "phone": { "type": "string", "required": false },
        "address": { "type": "string", "required": false },
        "website": { "type": "string", "required": false },
        "marginOverride": { "type": "number", "required": false },
        "permissions": { "type": "object", "required": true },
        "createdAt": { "type": "string", "required": true },
        "updatedAt": { "type": "string", "required": true }
      }
    },
    "Product": {
      "collection": "products",
      "fields": {
        "id": { "type": "string", "required": true },
        "title": { "type": "string", "required": true },
        "destinationId": { "type": "string", "required": true },
        "city": { "type": "string", "required": true },
        "productType": { "type": "string", "required": true },
        "category": { "type": "string", "required": true },
        "subcategory": { "type": "string", "required": false },
        "duration": { "type": "string", "required": true },
        "startingPrice": { "type": "number", "required": true },
        "nettPrice": { "type": "number", "required": true },
        "childPrice": { "type": "number", "required": false },
        "infantPrice": { "type": "number", "required": false },
        "currency": { "type": "string", "required": true },
        "supplierId": { "type": "string", "required": true },
        "supplierName": { "type": "string", "required": true },
        "supplierProductCode": { "type": "string", "required": false },
        "supplierContactDetails": { "type": "string", "required": false },
        "supplierLocalCurrency": { "type": "string", "required": false },
        "sla": { "type": "string", "required": false },
        "recommendedProductIds": { "type": "array", "required": false },
        "images": { "type": "array", "required": true },
        "inclusions": { "type": "array", "required": false },
        "exclusions": { "type": "array", "required": false },
        "highlights": { "type": "array", "required": false },
        "isPublished": { "type": "boolean", "required": true }
      }
    },
    "Quotation": {
      "collection": "quotations",
      "fields": {
        "id": { "type": "string", "required": true },
        "quoteNumber": { "type": "string", "required": true },
        "userId": { "type": "string", "required": true },
        "userType": { "type": "string", "required": true },
        "customerName": { "type": "string", "required": true },
        "customerEmail": { "type": "string", "required": true },
        "travelDate": { "type": "string", "required": true },
        "adults": { "type": "number", "required": true },
        "children": { "type": "number", "required": true },
        "infants": { "type": "number", "required": true },
        "currency": { "type": "string", "required": true },
        "items": { "type": "array", "required": true },
        "totalNett": { "type": "number", "required": true },
        "totalMargin": { "type": "number", "required": true },
        "totalTax": { "type": "number", "required": true },
        "totalFees": { "type": "number", "required": true },
        "totalDiscounts": { "type": "number", "required": true },
        "finalTotal": { "type": "number", "required": true },
        "status": { "type": "string", "required": true },
        "createdAt": { "type": "string", "required": true }
      }
    },
    "Booking": {
      "collection": "bookings",
      "fields": {
        "id": { "type": "string", "required": true },
        "bookingNumber": { "type": "string", "required": true },
        "quoteId": { "type": "string", "required": false },
        "userId": { "type": "string", "required": true },
        "customerName": { "type": "string", "required": true },
        "customerEmail": { "type": "string", "required": true },
        "customerPhone": { "type": "string", "required": false },
        "items": { "type": "array", "required": true },
        "totalAmount": { "type": "number", "required": true },
        "currency": { "type": "string", "required": true },
        "status": { "type": "string", "required": true },
        "paymentStatus": { "type": "string", "required": true },
        "travelDate": { "type": "string", "required": true },
        "createdAt": { "type": "string", "required": true },
        "slaDeadline": { "type": "string", "required": false }
      }
    },
    "Hotel": {
      "collection": "hotels",
      "fields": {
        "id": { "type": "string", "required": true },
        "name": { "type": "string", "required": true },
        "destinationId": { "type": "string", "required": true },
        "city": { "type": "string", "required": true },
        "address": { "type": "string", "required": true },
        "starRating": { "type": "number", "required": true },
        "images": { "type": "array", "required": true },
        "roomTypes": { "type": "array", "required": true },
        "mealPlans": { "type": "array", "required": true },
        "daywisePricing": { "type": "array", "required": false },
        "isPublished": { "type": "boolean", "required": true }
      }
    },
    "Lead": {
      "collection": "leads",
      "fields": {
        "id": { "type": "string", "required": true },
        "name": { "type": "string", "required": true },
        "email": { "type": "string", "required": true },
        "phone": { "type": "string", "required": false },
        "destination": { "type": "string", "required": true },
        "travelDate": { "type": "string", "required": false },
        "pax": { "type": "number", "required": false },
        "quoteValue": { "type": "number", "required": false },
        "status": { "type": "string", "required": true },
        "source": { "type": "string", "required": true },
        "createdAt": { "type": "string", "required": true }
      }
    },
    "FinancialInvoice": {
      "collection": "financial_invoices",
      "fields": {
        "id": { "type": "string", "required": true },
        "invoiceNumber": { "type": "string", "required": true },
        "bookingId": { "type": "string", "required": true },
        "userId": { "type": "string", "required": true },
        "customerName": { "type": "string", "required": true },
        "finalAmount": { "type": "number", "required": true },
        "currency": { "type": "string", "required": true },
        "status": { "type": "string", "required": true },
        "issueDate": { "type": "string", "required": true },
        "dueDate": { "type": "string", "required": true }
      }
    },
    "FinancialVoucher": {
      "collection": "financial_vouchers",
      "fields": {
        "id": { "type": "string", "required": true },
        "voucherNumber": { "type": "string", "required": true },
        "bookingId": { "type": "string", "required": true },
        "customerName": { "type": "string", "required": true },
        "supplierName": { "type": "string", "required": true },
        "travelDate": { "type": "string", "required": true },
        "status": { "type": "string", "required": true }
      }
    },
    "FinancialLedger": {
      "collection": "financial_ledgers",
      "fields": {
        "id": { "type": "string", "required": true },
        "transactionId": { "type": "string", "required": true },
        "userId": { "type": "string", "required": true },
        "type": { "type": "string", "required": true },
        "amount": { "type": "number", "required": true },
        "currency": { "type": "string", "required": true },
        "date": { "type": "string", "required": true }
      }
    },
    "Task": {
      "collection": "tasks",
      "fields": {
        "id": { "type": "string", "required": true },
        "triggerId": { "type": "string", "required": true },
        "type": { "type": "string", "required": true },
        "title": { "type": "string", "required": true },
        "dueAt": { "type": "string", "required": true },
        "status": { "type": "string", "required": true },
        "priority": { "type": "string", "required": true },
        "createdAt": { "type": "string", "required": true }
      }
    },
    "EmailLog": {
      "collection": "email_logs",
      "fields": {
        "id": { "type": "string", "required": true },
        "recipient": { "type": "string", "required": true },
        "subject": { "type": "string", "required": true },
        "trigger": { "type": "string", "required": true },
        "status": { "type": "string", "required": true },
        "timestamp": { "type": "string", "required": true }
      }
    },
    "AuditLog": {
      "collection": "audit_logs",
      "fields": {
        "id": { "type": "string", "required": true },
        "userId": { "type": "string", "required": true },
        "action": { "type": "string", "required": true },
        "module": { "type": "string", "required": true },
        "recordId": { "type": "string", "required": true },
        "timestamp": { "type": "string", "required": true }
      }
    }
  }
}
