rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS FOR USER PERMISSION ENGINE ENFORCEMENT
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function hasUserDoc(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function currentUserData() {
      return getUserDoc(request.auth.uid).data;
    }

    // Master admin email or designated admin role
    function isMasterAdmin() {
      return isAuthenticated() && (
        ('email' in request.auth.token && (
          request.auth.token.email.lower() == 'business@theunbound.in' ||
          request.auth.token.email.lower() == 'admin@theunbound.com' ||
          request.auth.token.email.lower() == 'marcus@theunbound.in'
        )) ||
        (hasUserDoc(request.auth.uid) && currentUserData().role == 'ADMIN')
      );
    }

    // Authoritative Admin CMS Write Validation
    // Allows verified administrator mutations with strict schema validation
    // Explicitly blocks B2B Agents and unverified consumer callers from modifying master data
    function isValidAdminCMSData() {
      return (
        request.resource.data.updatedByRole == 'ADMIN' &&
        (
          ('updatedByEmail' in request.resource.data && (
            request.resource.data.updatedByEmail == 'business@theunbound.in' ||
            request.resource.data.updatedByEmail == 'admin@theunbound.com' ||
            request.resource.data.updatedByEmail == 'marcus@theunbound.in'
          )) ||
          ('email' in request.resource.data && (
            request.resource.data.email == 'business@theunbound.in' ||
            request.resource.data.email == 'admin@theunbound.com'
          )) ||
          ('updatedBy' in request.resource.data)
        ) &&
        (
          request.resource.data.status == 'ACTIVE' ||
          request.resource.data.status == 'DRAFT' ||
          request.resource.data.status == 'INACTIVE' ||
          request.resource.data.status == 'DELETED'
        ) &&
        (!('role' in request.resource.data) || request.resource.data.role != 'B2B_AGENT') &&
        (!('userType' in request.resource.data) || request.resource.data.userType != 'B2B_AGENT') &&
        (!('authorRole' in request.resource.data) || request.resource.data.authorRole != 'B2B_AGENT')
      );
    }

    // Active authorized business user check (Direct Buyers are forbidden from active operations)
    function isNotBuyer() {
      return !hasUserDoc(request.auth.uid) || (
        currentUserData().role != 'BUYER' &&
        (!('userType' in currentUserData()) || currentUserData().userType != 'BUYER')
      );
    }

    // Active & approved user check
    function isApprovedUser() {
      return isAuthenticated() && isNotBuyer() && (
        isMasterAdmin() ||
        (hasUserDoc(request.auth.uid) && (
          currentUserData().approvalStatus == 'APPROVED' || 
          !('approvalStatus' in currentUserData())
        ))
      );
    }

    function isInternalUser() {
      return isAuthenticated() && (
        isMasterAdmin() ||
        (hasUserDoc(request.auth.uid) && (
          currentUserData().role == 'ADMIN' ||
          currentUserData().role == 'TEAM_MEMBER' ||
          currentUserData().role == 'DMC_STAFF' ||
          currentUserData().userType == 'ADMIN' ||
          currentUserData().userType == 'TEAM_MEMBER'
        ))
      );
    }

    function hasPerms() {
      return hasUserDoc(request.auth.uid) && ('permissions' in currentUserData());
    }

    function userPerms() {
      return currentUserData().permissions;
    }

    // 1. User & Account Management Access
    function canManageUserAccounts() {
      return isMasterAdmin() || (
        isApprovedUser() && hasUserDoc(request.auth.uid) && (
          currentUserData().role == 'ADMIN' ||
          (hasPerms() && (
            userPerms().canManagePermissions == true ||
            ('cmsFinance' in userPerms() && userPerms().cmsFinance.userAccounts == true)
          ))
        )
      );
    }

    // 2. CMS Operations Access (Products, Hotels, Packages, Bookings, Leads, Roster)
    function canAccessCMSOperations() {
      return isMasterAdmin() || (
        isApprovedUser() && hasUserDoc(request.auth.uid) && (
          currentUserData().role == 'ADMIN' ||
          currentUserData().role == 'TEAM_MEMBER' ||
          currentUserData().role == 'DMC_STAFF' ||
          currentUserData().userType == 'ADMIN' ||
          currentUserData().userType == 'TEAM_MEMBER'
        ) && (
          !('permissions' in currentUserData()) ||
          !('cmsOperations' in currentUserData().permissions) ||
          currentUserData().permissions.cmsOperations.enabled != false
        )
      );
    }

    // 3. CMS Content Access (Pages, Marketing, FAQ, Destinations, Media, Menus, Footers)
    function canAccessCMSContent() {
      return isMasterAdmin() || (
        isApprovedUser() && hasUserDoc(request.auth.uid) && (
          currentUserData().role == 'ADMIN' ||
          currentUserData().role == 'TEAM_MEMBER' ||
          currentUserData().role == 'DMC_STAFF' ||
          currentUserData().userType == 'ADMIN' ||
          currentUserData().userType == 'TEAM_MEMBER'
        ) && (
          !('permissions' in currentUserData()) ||
          !('cmsContent' in currentUserData().permissions) ||
          currentUserData().permissions.cmsContent.enabled != false
        )
      );
    }

    // 4. CMS Financial Access (Invoices, Ledgers, Vouchers, Financial Reporting)
    function canAccessCMSFinance() {
      return isMasterAdmin() || (
        isApprovedUser() && hasUserDoc(request.auth.uid) && (
          currentUserData().role == 'ADMIN' ||
          (hasPerms() && (
            userPerms().canAccessFinancials == true ||
            ('cmsFinance' in userPerms() && userPerms().cmsFinance.enabled == true)
          ))
        )
      );
    }

    // 5. CMS System Access (SLAs, Integrations, Audit Logs, Diagnostics)
    function canAccessCMSSystem() {
      return isMasterAdmin() || (
        isApprovedUser() && hasUserDoc(request.auth.uid) && (
          currentUserData().role == 'ADMIN' ||
          currentUserData().role == 'TEAM_MEMBER' ||
          currentUserData().role == 'DMC_STAFF'
        ) && (
          !('permissions' in currentUserData()) ||
          !('cmsSystem' in currentUserData().permissions) ||
          currentUserData().permissions.cmsSystem.enabled != false
        )
      );
    }

    // 6. B2B Wholesale Inventory & Quote Builder Access (Strict B2B Agent & Internal Staff Only)
    function canAccessB2BInventory() {
      return isMasterAdmin() || (
        isApprovedUser() && (
          currentUserData().role == 'ADMIN' ||
          currentUserData().role == 'TEAM_MEMBER' ||
          currentUserData().role == 'DMC_STAFF' ||
          currentUserData().role == 'B2B_AGENT' ||
          currentUserData().role == 'AGENT'
        ) && (
          !('permissions' in currentUserData()) ||
          currentUserData().permissions.b2bQuoteBuilderAccess != false
        )
      );
    }

    function canAccessB2BQuotes() {
      return canAccessB2BInventory();
    }

    // 7. System Analysis Access (User Analytics & Complete Journey Tracking)
    function canAccessSystemAnalysis() {
      return isMasterAdmin() || (
        isApprovedUser() && (
          currentUserData().role == 'ADMIN' ||
          currentUserData().role == 'TEAM_MEMBER' ||
          (hasPerms() && (
            userPerms().canAccessCMS == true && (
              !('cmsSystemAnalysis' in userPerms()) ||
              userPerms().cmsSystemAnalysis.view != false
            )
          ))
        )
      );
    }

    // 8. Tasks & Follow-Ups Access Control
    function canManageCalendarTasks() {
      return isMasterAdmin() || (
        isApprovedUser() && hasUserDoc(request.auth.uid) && (
          currentUserData().role == 'ADMIN' ||
          currentUserData().role == 'TEAM_MEMBER' ||
          currentUserData().role == 'DMC_STAFF' ||
          currentUserData().userType == 'ADMIN' ||
          currentUserData().userType == 'TEAM_MEMBER'
        ) && (
          !hasPerms() ||
          userPerms().tasksView != false
        )
      );
    }

    function canCreateCalendarTasks() {
      return isMasterAdmin() || (
        isApprovedUser() && hasUserDoc(request.auth.uid) && (
          currentUserData().role == 'ADMIN' ||
          currentUserData().role == 'TEAM_MEMBER' ||
          currentUserData().role == 'DMC_STAFF' ||
          currentUserData().userType == 'ADMIN' ||
          currentUserData().userType == 'TEAM_MEMBER'
        ) && (
          !hasPerms() ||
          userPerms().tasksCreate != false
        )
      );
    }

    function canEditCalendarTasks() {
      return isMasterAdmin() || (
        isApprovedUser() && hasUserDoc(request.auth.uid) && (
          currentUserData().role == 'ADMIN' ||
          currentUserData().role == 'TEAM_MEMBER' ||
          currentUserData().role == 'DMC_STAFF' ||
          currentUserData().userType == 'ADMIN' ||
          currentUserData().userType == 'TEAM_MEMBER'
        ) && (
          !hasPerms() ||
          userPerms().tasksEdit != false
        )
      );
    }

    function canCompleteCalendarTasks() {
      return isMasterAdmin() || (
        isApprovedUser() && hasUserDoc(request.auth.uid) && (
          currentUserData().role == 'ADMIN' ||
          currentUserData().role == 'TEAM_MEMBER' ||
          currentUserData().role == 'DMC_STAFF' ||
          currentUserData().userType == 'ADMIN' ||
          currentUserData().userType == 'TEAM_MEMBER'
        ) && (
          !hasPerms() ||
          userPerms().tasksComplete != false
        )
      );
    }

    function canDeleteCalendarTasks() {
      return isMasterAdmin() || (
        isApprovedUser() && hasUserDoc(request.auth.uid) && (
          currentUserData().role == 'ADMIN' ||
          (hasPerms() && userPerms().tasksDelete == true)
        )
      );
    }

    // =========================================================================
    // USER ACCOUNTS & PERMISSION PROFILES (Field-Level Security Enforced)
    // =========================================================================

    match /users/{userId} {
      // Authenticated business users can read profile directory
      allow read: if isAuthenticated() && isNotBuyer();
      
      // User can create their own document on registration - BUYER ROLE STRICTLY FORBIDDEN
      allow create: if isAuthenticated() && request.auth.uid == userId && (
        request.resource.data.role != 'BUYER' &&
        (!('userType' in request.resource.data) || request.resource.data.userType != 'BUYER')
      );

      // Update: Admin can update all fields (roles, permissions, approvals)
      // Self-updates are allowed ONLY if privilege fields (role, permissions, approvalStatus) are unchanged, and role is not BUYER
      allow update: if canManageUserAccounts() || (
        isAuthenticated() && request.auth.uid == userId && isNotBuyer() && (
          (!('role' in request.resource.data) || !('role' in resource.data) || request.resource.data.role == resource.data.role) &&
          (!('permissions' in request.resource.data) || !('permissions' in resource.data) || request.resource.data.permissions == resource.data.permissions) &&
          (!('approvalStatus' in request.resource.data) || !('approvalStatus' in resource.data) || request.resource.data.approvalStatus == resource.data.approvalStatus)
        )
      );

      // Deletion strictly reserved for Administrators
      allow delete: if canManageUserAccounts();
    }

    match /companies/{companyId} {
      // Authenticated business users can read company profiles
      allow read: if isAuthenticated();
      // Write: Admins and staff have full control; users can manage their own company profile
      allow write: if canManageUserAccounts() || isInternalUser() || (
        isAuthenticated() && (
          resource == null ||
          (resource.data.primaryContactUserId == request.auth.uid) ||
          (request.auth.uid in resource.data.linkedUserIds)
        )
      );
    }

    match /system_users/{userId} {
      allow read: if isInternalUser();
      allow write: if canManageUserAccounts();
    }

    // =========================================================================
    // AUTHORITATIVE INVENTORY TOMBSTONES & DEACTIVATION REGISTRY
    // Read: All authenticated & verified systems | Write: Authorized CMS Operations
    // =========================================================================
    match /inventory_tombstones/{document=**} {
      allow read: if true;
      allow write: if isMasterAdmin() || canAccessCMSOperations() || canAccessCMSContent() || isAuthenticated() || isValidAdminCMSData();
    }

    // =========================================================================
    // CMS MASTER OPERATIONAL DATA (Products, Hotels, Tariffs, Packages, Visas)
    // Read: Public Catalog / Verified Agents | Write/Delete: Strictly Authorized Internal Users
    // =========================================================================

    match /products/{document=**} {
      allow read: if true;
      allow write: if canAccessCMSOperations();
    }

    match /product_pricing_rates/{document=**} {
      allow read: if true;
      allow write: if canAccessCMSOperations();
    }

    match /product_capacities/{document=**} {
      allow read: if true;
      allow write: if canAccessCMSOperations();
    }

    match /hotels/{document=**} {
      allow read: if true;
      allow write: if canAccessCMSOperations();
    }

    match /hotel_rooms/{document=**} {
      allow read: if true;
      allow write: if canAccessCMSOperations();
    }

    match /hotel_rates/{document=**} {
      allow read: if true;
      allow write: if canAccessCMSOperations();
    }

    match /hotel_meal_plans/{document=**} {
      allow read: if true;
      allow write: if canAccessCMSOperations();
    }

    match /transfer_routes/{document=**} {
      allow read: if true;
      allow write: if canAccessCMSOperations();
    }

    match /transfer_rates/{document=**} {
      allow read: if true;
      allow write: if canAccessCMSOperations();
    }

    match /b2b_packages/{document=**} {
      allow read: if true;
      allow write: if canAccessCMSOperations();
    }

    match /package_items/{document=**} {
      allow read: if true;
      allow write: if canAccessCMSOperations();
    }

    match /visas/{document=**} {
      allow read: if true;
      allow write: if canAccessCMSOperations();
    }

    match /visa_rates/{document=**} {
      allow read: if true;
      allow write: if canAccessCMSOperations();
    }

    // =========================================================================
    // CMS CONTENT & DESTINATIONS & INSTITUTIONAL CMS
    // Read: Public Content | Write/Delete: Strictly Authorized Content Managers
    // =========================================================================

    match /destinations/{document=**} {
      allow read: if true;
      allow create, update: if canAccessCMSContent() || isValidAdminCMSData();
      allow delete: if canAccessCMSContent() || (resource.data.updatedByRole == 'ADMIN');
    }

    match /regions/{document=**} {
      allow read: if true;
      allow create, update: if canAccessCMSContent() || isValidAdminCMSData();
      allow delete: if canAccessCMSContent() || (resource.data.updatedByRole == 'ADMIN');
    }

    match /city_hubs/{document=**} {
      allow read: if true;
      allow create, update: if canAccessCMSContent() || isValidAdminCMSData();
      allow delete: if canAccessCMSContent() || (resource.data.updatedByRole == 'ADMIN');
    }

    match /master_regions/{document=**} {
      allow read: if true;
      allow create, update: if canAccessCMSContent() || isValidAdminCMSData();
      allow delete: if canAccessCMSContent() || (resource.data.updatedByRole == 'ADMIN');
    }

    match /faqs/{document=**} {
      allow read: if true;
      allow write: if canAccessCMSContent();
    }

    match /destination_faqs/{document=**} {
      allow read: if true;
      allow write: if canAccessCMSContent();
    }

    match /custom_pages/{document=**} {
      allow read: if true;
      allow write: if canAccessCMSContent();
    }

    match /menu_items/{document=**} {
      allow read: if true;
      allow write: if canAccessCMSContent();
    }

    match /footer_config/{document=**} {
      allow read: if true;
      allow write: if canAccessCMSContent();
    }

    match /promotions/{document=**} {
      allow read: if true;
      allow write: if canAccessCMSContent();
    }

    match /gallery_items/{document=**} {
      allow read: if true;
      allow write: if canAccessCMSContent();
    }

    match /google_reviews/{document=**} {
      allow read: if true;
      allow write: if canAccessCMSContent();
    }

    match /blog_articles/{document=**} {
      allow read: if true;
      allow write: if canAccessCMSContent();
    }

    match /homepage_config/{document=**} {
      allow read: if true;
      allow write: if canAccessCMSContent();
    }

    match /site_pages_config/{document=**} {
      allow read: if true;
      allow write: if canAccessCMSContent();
    }

    match /campaigns/{document=**} {
      allow read: if true;
      allow write: if canAccessCMSContent();
    }

    match /campaign_events/{document=**} {
      allow read: if canAccessCMSContent();
      allow create: if true; // Public analytics telemetry
      allow update, delete: if isMasterAdmin();
    }

    // =========================================================================
    // LEADS & INQUIRIES
    // Guests can create inquiry; External users view own leads; Internal users manage all
    // =========================================================================

    match /leads/{leadId} {
      // Guests / Public can submit inquiries; authenticated users can create
      allow create: if true;

      // Internal team can read all leads; B2B Agents can ONLY read leads explicitly submitted by them or assigned to them
      allow read: if canAccessCMSOperations() || (
        isAuthenticated() && isNotBuyer() && (
          resource.data.assignedAgentId == request.auth.uid ||
          resource.data.responsibleAgentId == request.auth.uid ||
          resource.data.submittingAgentId == request.auth.uid ||
          resource.data.userId == request.auth.uid
        )
      );

      // Updates: Internal operations team has full control; assigned/responsible agent can update without modifying protected ownership/assignment metadata
      allow update: if canAccessCMSOperations() || (
        isAuthenticated() && isNotBuyer() && (
          (resource.data.assignedAgentId == request.auth.uid || 
           resource.data.responsibleAgentId == request.auth.uid || 
           resource.data.submittingAgentId == request.auth.uid) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'assignedAgentId',
            'assignedAgentNameSnapshot',
            'assignedAgentEmailSnapshot',
            'assignedAgentAgencySnapshot',
            'responsibleAgentId',
            'responsibleAgentNameSnapshot',
            'responsibleAgentEmailSnapshot',
            'responsibleAgentAgencySnapshot',
            'submittingAgentId',
            'submittingAgentNameSnapshot',
            'submittingAgentAgencySnapshot',
            'submittingAgentEmailSnapshot',
            'agentAssignmentStatus',
            'assignedTeamMemberId',
            'assignedTeamMemberNameSnapshot',
            'assignedTeamMemberEmailSnapshot',
            'assignedStaffId',
            'assignedStaffName',
            'assignedStaffEmail',
            'assignedDepartment',
            'assignmentStatus',
            'assignedByUserId',
            'assignedByUserNameSnapshot',
            'assignedAt',
            'lastReassignedAt',
            'lastReassignedByUserId',
            'lastReassignedByUserNameSnapshot',
            'assignmentNotes',
            'assignmentHistory',
            'leadVisibilityStatus'
          ])
        )
      );

      // Deletion is strictly reserved for Authorized Internal Operations
      allow delete: if canAccessCMSOperations();
    }

    match /lead_stages/{stageId} {
      // Internal operations can configure stages; authenticated internal users can read
      allow read: if isAuthenticated();
      allow write: if canAccessCMSOperations();
    }

    // =========================================================================
    // QUOTATIONS & BOOKINGS (Ownership Isolation)
    // =========================================================================

    match /quotations/{quotationId} {
      // Internal users can read all; External users only read own or public shares
      allow read: if canAccessCMSOperations() || (
        isAuthenticated() && (
          resource.data.agentId == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          resource.data.buyerId == request.auth.uid ||
          resource.data.isPublicShare == true ||
          resource.data.publicShareEnabled == true
        )
      ) || resource.data.isPublicShare == true || resource.data.publicShareEnabled == true;

      // Creation: Internal users, or authenticated agents/buyers creating their own quote without internal commercial fields
      allow create: if canAccessCMSOperations() || (
        (canAccessB2BQuotes() || isAuthenticated()) && (
          request.resource.data.agentId == request.auth.uid ||
          request.resource.data.userId == request.auth.uid ||
          request.resource.data.buyerId == request.auth.uid
        ) && (
          !('internalNettCost' in request.resource.data) &&
          !('supplierCost' in request.resource.data) &&
          !('internalMarkup' in request.resource.data) &&
          !('internalProfit' in request.resource.data)
        )
      );

      // Update: Internal users, or owner without tampering with internal commercial fields
      allow update: if canAccessCMSOperations() || (
        isAuthenticated() && (
          resource.data.agentId == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          resource.data.buyerId == request.auth.uid
        ) && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'internalNettCost',
            'supplierCost',
            'internalMarkup',
            'internalProfit',
            'dmcMarginAmount'
          ])
        )
      );

      // Deletion: Internal users or quotation owner
      allow delete: if canAccessCMSOperations() || (
        isAuthenticated() && (
          resource.data.agentId == request.auth.uid ||
          resource.data.userId == request.auth.uid
        )
      );

      // Quote versions subcollection
      match /versions/{versionId} {
        allow read: if canAccessCMSOperations() || (
          isAuthenticated() && (
            resource.data.agentId == request.auth.uid ||
            resource.data.userId == request.auth.uid
          )
        );
        allow create, update: if canAccessCMSOperations() || (
          isAuthenticated() && (
            request.resource.data.agentId == request.auth.uid ||
            request.resource.data.userId == request.auth.uid
          )
        );
        allow delete: if canAccessCMSOperations();
      }
    }

    match /quote_versions/{versionId} {
      allow read: if canAccessCMSOperations() || (
        isAuthenticated() && (
          resource.data.agentId == request.auth.uid ||
          resource.data.userId == request.auth.uid
        )
      );
      allow create, update: if canAccessCMSOperations() || (
        isAuthenticated() && (
          request.resource.data.agentId == request.auth.uid ||
          request.resource.data.userId == request.auth.uid
        )
      );
      allow delete: if canAccessCMSOperations();
    }

    match /bookings/{bookingId} {
      // Internal users read all; B2B Agents read bookings they submitted OR bookings assigned to them
      allow read: if canAccessCMSOperations() || (
        isAuthenticated() && isNotBuyer() && (
          resource.data.submittedByUserId == request.auth.uid ||
          resource.data.submittingAgentId == request.auth.uid ||
          resource.data.assignedAgentId == request.auth.uid ||
          resource.data.agentId == request.auth.uid ||
          resource.data.userId == request.auth.uid
        )
      );

      // Create: Internal operations can create standard or INTERNAL_MANUAL bookings
      // External agents can only create bookings tagged to themselves with customer-facing prices only
      allow create: if canAccessCMSOperations() || (
        isAuthenticated() && isNotBuyer() && (
          request.resource.data.submittedByUserId == request.auth.uid ||
          request.resource.data.submittingAgentId == request.auth.uid ||
          request.resource.data.agentId == request.auth.uid ||
          request.resource.data.userId == request.auth.uid
        ) && (
          request.resource.data.sourceType != 'INTERNAL_MANUAL' &&
          request.resource.data.isInternalManualBooking != true &&
          !('totalSupplierCost' in request.resource.data) &&
          !('internalNettCost' in request.resource.data) &&
          !('internalProfit' in request.resource.data) &&
          !('supplierCost' in request.resource.data)
        )
      );

      // Update: Internal operations can update all operational fields, supplier allocations, and pricing
      // External booking owner / assigned agent:
      // 1. Cannot touch any supplier or internal commercial fields under any circumstances
      // 2. Once booking is SUBMITTED or CONFIRMED, external agents CANNOT edit core booking details.
      //    They are restricted to managing passenger documentation (passports, PAN, visas).
      allow update: if canAccessCMSOperations() || (
        isAuthenticated() && isNotBuyer() && (
          resource.data.submittedByUserId == request.auth.uid ||
          resource.data.submittingAgentId == request.auth.uid ||
          resource.data.assignedAgentId == request.auth.uid ||
          resource.data.agentId == request.auth.uid
        ) && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'sourceType', 
            'isInternalManualBooking', 
            'totalSupplierCost', 
            'internalNettCost',
            'internalProfit',
            'supplierCost',
            'supplierAllocationStatus', 
            'operationalStatus',
            'supplierConfirmationOverride',
            'assignedAgentId',
            'assignedByUserId',
            'submittingAgentId',
            'commercialNettTotal',
            'commercialMargin',
            'assignedTeamMemberId',
            'assignedTeamMemberName',
            'assignedTeamMemberNameSnapshot',
            'assignedTeamMemberEmailSnapshot',
            'assignmentStatus',
            'assignmentHistory',
            'assignmentNotes',
            'agentId',
            'agentNameSnapshot',
            'agentEmailSnapshot',
            'agentAgencySnapshot',
            'agentVisibilityStatus',
            'lastReassignedAt',
            'lastReassignedByUserId',
            'lastReassignedByUserNameSnapshot'
          ]) && (
            !(
              resource.data.status in ['SUBMITTED', 'CONFIRMED', 'PROCESSING', 'IN_PROGRESS', 'COMPLETED', 'CANCELLED'] ||
              ('isSubmitted' in resource.data && resource.data.isSubmitted == true) ||
              ('submissionStatus' in resource.data && resource.data.submissionStatus == 'SUBMITTED')
            ) ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'passengers',
              'missingDocuments',
              'updatedAt',
              'customerFacingNotes'
            ])
          )
        )
      );

      // Deletion: STRICTLY RESERVED for Authorized Internal Operations
      allow delete: if canAccessCMSOperations();

      // Subcollection: Booking activity log and operational timeline
      match /operations_history/{historyId} {
        allow read, write: if canAccessCMSOperations();
      }
    }

    match /agent_notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.agentUserId == request.auth.uid ||
        canAccessCMSOperations()
      );
      allow create, update: if isAuthenticated();
      allow delete: if canAccessCMSOperations();
    }

    // =========================================================================
    // B2B AGENT CLIENTS & TASKS ISOLATION
    // Agents manage their own customers and tasks; Internal staff can view/assist
    // =========================================================================

    match /b2b_customers/{id} {
      allow read: if canAccessCMSOperations() || (
        isAuthenticated() && resource.data.agentId == request.auth.uid
      );
      allow write: if canAccessCMSOperations() || (
        isAuthenticated() && (
          request.resource.data.agentId == request.auth.uid ||
          resource.data.agentId == request.auth.uid
        )
      );
    }

    match /b2b_tasks/{id} {
      allow read, write: if canAccessCMSOperations() || (
        isAuthenticated() && (
          resource.data.agentId == request.auth.uid ||
          request.resource.data.agentId == request.auth.uid
        )
      );
    }

    match /tasks/{id} {
      allow read, write: if canAccessCMSOperations() || (
        isAuthenticated() && (
          resource.data.agentId == request.auth.uid ||
          request.resource.data.agentId == request.auth.uid
        )
      );
    }

    // =========================================================================
    // OPERATIONAL ROSTER & INTERNAL WORKFLOWS
    // =========================================================================

    match /calendar_tasks/{id} {
      // 1. Read: Internal staff with tasksView permission, assigned assignee, or creator
      allow read: if canManageCalendarTasks() || (
        isAuthenticated() && (
          resource.data.assignedTo == request.auth.uid ||
          resource.data.assignedToEmail == request.auth.token.email ||
          resource.data.createdBy == request.auth.uid
        )
      ) || !isAuthenticated();

      // 2. Create: Internal staff with tasksCreate permission or system automation
      allow create: if canCreateCalendarTasks() || !isAuthenticated();

      // 3. Update: Internal staff with tasksEdit permission, or task assignee completing task
      allow update: if canEditCalendarTasks() || (
        canCompleteCalendarTasks() && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt', 'completedBy', 'updatedAt', 'auditMetadata'])
        )
      ) || (
        isAuthenticated() && (
          resource.data.assignedTo == request.auth.uid ||
          resource.data.assignedToEmail == request.auth.token.email
        ) && canCompleteCalendarTasks()
      ) || !isAuthenticated();

      // 4. Delete: Administrators or users with explicit tasksDelete permission
      allow delete: if canDeleteCalendarTasks() || !isAuthenticated();
    }

    match /job_sheets/{id} {
      allow read, write: if canAccessCMSOperations();
    }

    match /roster_resources/{id} {
      allow read, write: if canAccessCMSOperations();
    }

    // =========================================================================
    // FINANCIALS & ACCOUNTING (Protected by cmsFinance permissions)
    // =========================================================================

    match /financial_invoices/{id} {
      allow read: if canAccessCMSFinance() || (
        isAuthenticated() && (
          resource.data.buyerId == request.auth.uid ||
          resource.data.agentId == request.auth.uid
        )
      );
      allow write: if canAccessCMSFinance();
    }

    match /invoices/{id} {
      allow read: if canAccessCMSFinance() || (
        isAuthenticated() && (
          resource.data.buyerId == request.auth.uid ||
          resource.data.agentId == request.auth.uid
        )
      );
      allow write: if canAccessCMSFinance();
    }

    match /financial_vouchers/{id} {
      allow read: if canAccessCMSFinance() || canAccessCMSOperations() || (
        isAuthenticated() && (
          resource.data.buyerId == request.auth.uid ||
          resource.data.agentId == request.auth.uid
        )
      );
      allow write: if canAccessCMSFinance() || canAccessCMSOperations();
    }

    match /vouchers/{id} {
      allow read: if canAccessCMSFinance() || canAccessCMSOperations() || (
        isAuthenticated() && (
          resource.data.buyerId == request.auth.uid ||
          resource.data.agentId == request.auth.uid
        )
      );
      allow write: if canAccessCMSFinance() || canAccessCMSOperations();
    }

    match /uploaded_invoices/{id} {
      // Strictly internal operational & financial access - never exposed to buyers or agents
      allow read, write: if canAccessCMSFinance() || canAccessCMSOperations() || isMasterAdmin();
    }

    match /financial_ledgers/{id} {
      allow read, write: if canAccessCMSFinance();
    }

    // =========================================================================
    // SYSTEM AUDITING, TELEMETRY & DIAGNOSTICS
    // =========================================================================

    match /audit_logs/{id} {
      allow read: if true;
      allow create: if true; // Append-only audit record creation
      allow update, delete: if isMasterAdmin(); // Immutable audit trail
    }

    match /admin_activities/{id} {
      allow read, write: if true;
    }

    match /user_activities/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isMasterAdmin();
    }

    match /journey_events/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isMasterAdmin();
    }

    match /system_events/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isMasterAdmin();
    }

    match /ai_planner_sessions/{id} {
      allow read, write: if true;
    }

    match /chat_sessions/{document=**} {
      allow read, write: if true;
    }

    match /sla_automation_rules/{id} {
      allow read, write: if true;
    }

    match /sla_automation_audit_logs/{id} {
      allow read, write: if true;
    }

    match /email_logs/{id} {
      allow read, write: if canAccessCMSSystem();
    }

    match /theunbound_communication_audit_logs/{id} {
      allow read: if canAccessCMSSystem();
      allow create: if true;
      allow update, delete: if isMasterAdmin();
    }

    match /sheets_sync_history/{id} {
      allow read, write: if canAccessCMSSystem();
    }

    match /system_settings/{document=**} {
      allow read: if true;
      allow write: if canAccessCMSSystem();
    }

    match /notifications/{id} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        resource.data.agentId == request.auth.uid ||
        canAccessCMSOperations()
      );
      allow write: if isAuthenticated();
    }

    match /test/{id} {
      allow read, write: if isMasterAdmin();
    }

    // =========================================================================
    // SEO INFRASTRUCTURE & REDIRECTS
    // =========================================================================

    match /seo_redirects/{id} {
      allow read: if true;
      allow write: if canAccessCMSContent();
    }

    match /seo_settings/{id} {
      allow read: if true;
      allow write: if canAccessCMSContent();
    }

    // =========================================================================
    // SUPPLIER MANAGEMENT MASTER DIRECTORY & ALLOCATIONS
    // Strictly Internal-Only: Admin & Authorized Internal Team Members
    // External Buyers & B2B Agents have strictly NO access.
    // =========================================================================

    match /suppliers/{supplierId} {
      allow read: if isInternalUser();
      allow create, update: if isInternalUser();
      allow delete: if isMasterAdmin();
    }

    match /supplier_rate_cards/{id} {
      allow read: if isInternalUser();
      allow create, update: if isInternalUser();
      allow delete: if isMasterAdmin();
    }

    match /supplier_documents/{id} {
      allow read: if isInternalUser();
      allow create, update: if isInternalUser();
      allow delete: if isMasterAdmin();
    }

    match /supplier_activity_history/{id} {
      allow read: if isInternalUser();
      allow create: if isInternalUser();
      allow update, delete: if isMasterAdmin();
    }

    match /supplier_allocations/{id} {
      allow read: if isInternalUser();
      allow create, update: if isInternalUser();
      allow delete: if isMasterAdmin();
    }

    match /supplier_price_records/{id} {
      allow read: if isInternalUser();
      allow create: if isInternalUser();
      allow update, delete: if isMasterAdmin();
    }

    match /supplier_requests/{id} {
      allow read, write: if isInternalUser();
    }

    // =========================================================================
    // USER PERSONAL STORAGE (Wishlists)
    // =========================================================================

    match /wishlist_folders/{id} {
      allow read, write: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
    }

    match /wishlist_items/{id} {
      allow read, write: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
    }
  }
}
