rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS FOR USER PERMISSION ENGINE ENFORCEMENT
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function getUserDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function hasUserDoc(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function currentUserData() {
      return getUserDoc(request.auth.uid).data;
    }

    function currentRole() {
      return hasUserDoc(request.auth.uid)
        ? currentUserData().get('role', currentUserData().get('userType', ''))
        : '';
    }

    // Super Admin (bootstrapped master email or explicit SUPER_ADMIN role)
    function isSuperAdmin() {
      return isAuthenticated() && (
        ('email' in request.auth.token && request.auth.token.email is string && (
          request.auth.token.email.lower() == 'business@theunbound.in' ||
          request.auth.token.email.lower() == 'admin@theunbound.com' ||
          request.auth.token.email.lower() == 'marcus@theunbound.in'
        )) ||
        (hasUserDoc(request.auth.uid) && (
          currentUserData().get('role', '') == 'SUPER_ADMIN' ||
          currentUserData().get('userType', '') == 'SUPER_ADMIN'
        ))
      );
    }

    // Master admin email or designated admin role (CEL null-safe)
    function isMasterAdmin() {
      return isSuperAdmin() || (
        isAuthenticated() && hasUserDoc(request.auth.uid) && (
          currentUserData().get('role', '') == 'ADMIN' ||
          currentUserData().get('userType', '') == 'ADMIN'
        ) && currentUserData().get('approvalStatus', 'APPROVED') == 'APPROVED'
      );
    }

    // Verifies if the existing document was marked with Administrator ownership
    function isResourceAdminOwned() {
      return resource != null && 'data' in resource && 'updatedByRole' in resource.data && (
        resource.data.updatedByRole == 'ADMIN' ||
        resource.data.updatedByRole == 'SUPER_ADMIN'
      );
    }

    // Authoritative Admin CMS Write Validation
    // Allows verified administrator mutations with strict schema validation
    // Explicitly blocks B2B Agents and unverified consumer callers from modifying master data
    function isValidAdminCMSData() {
      return (
        request.resource != null &&
        'data' in request.resource &&
        'updatedByRole' in request.resource.data &&
        (request.resource.data.updatedByRole == 'ADMIN' || request.resource.data.updatedByRole == 'SUPER_ADMIN') &&
        (
          ('updatedByEmail' in request.resource.data && (
            request.resource.data.updatedByEmail == 'business@theunbound.in' ||
            request.resource.data.updatedByEmail == 'admin@theunbound.com' ||
            request.resource.data.updatedByEmail == 'marcus@theunbound.in'
          )) ||
          ('email' in request.resource.data && (
            request.resource.data.email == 'business@theunbound.in' ||
            request.resource.data.email == 'admin@theunbound.com'
          )) ||
          ('updatedBy' in request.resource.data)
        ) &&
        (
          !('status' in request.resource.data) ||
          request.resource.data.status in [
            'ACTIVE', 'Active', 'DRAFT', 'Draft', 'INACTIVE', 'Inactive', 'DELETED', 'Deleted',
            'PUBLISHED', 'Published', 'UNPUBLISHED', 'Unpublished', 'ARCHIVED', 'Archived',
            'COMING_SOON', 'Coming Soon', 'CONFIRMED', 'Confirmed', 'PENDING', 'Pending',
            'CANCELLED', 'Cancelled', 'COMPLETED', 'Completed', 'NEW', 'New',
            'CONTACTED', 'Contacted', 'PROPOSAL_SENT', 'Proposal Sent', 'NEGOTIATION', 'Negotiation',
            'WON', 'Won', 'LOST', 'Lost', 'QUALIFIED', 'Qualified', 'PENDING_APPROVAL', 'SUSPENDED',
            'SYNCED', 'Synced', 'REVIEW', 'Review'
          ]
        ) &&
        (!('role' in request.resource.data) || (request.resource.data.role != 'B2B_AGENT' && request.resource.data.role != 'BUYER')) &&
        (!('userType' in request.resource.data) || (request.resource.data.userType != 'B2B_AGENT' && request.resource.data.userType != 'BUYER')) &&
        (!('authorRole' in request.resource.data) || (request.resource.data.authorRole != 'B2B_AGENT' && request.resource.data.authorRole != 'BUYER'))
      );
    }

    // Active authorized business user check (Direct Buyers are forbidden from active operations)
    function isNotBuyer() {
      return !hasUserDoc(request.auth.uid) || (
        currentUserData().role != 'BUYER' &&
        (!('userType' in currentUserData()) || currentUserData().userType != 'BUYER')
      );
    }

    // Active & approved user check
    function isApprovedUser() {
      return isAuthenticated() && isNotBuyer() && (
        isMasterAdmin() ||
        (hasUserDoc(request.auth.uid) && (
          currentUserData().approvalStatus == 'APPROVED' || 
          !('approvalStatus' in currentUserData())
        ))
      );
    }

    function isInternalUser() {
      return isAuthenticated() && (
        isMasterAdmin() ||
        (hasUserDoc(request.auth.uid) && (
          currentUserData().get('role', '') in ['SUPER_ADMIN', 'ADMIN', 'TEAM_MEMBER', 'DMC_STAFF'] ||
          currentUserData().get('userType', '') in ['SUPER_ADMIN', 'ADMIN', 'TEAM_MEMBER', 'DMC_STAFF']
        ))
      );
    }

    function hasPerms() {
      return hasUserDoc(request.auth.uid) &&
        ('permissions' in currentUserData()) &&
        currentUserData().permissions is map;
    }

    function userPerms() {
      return currentUserData().permissions;
    }

    function hasBookingOpsPerm(key, defaultVal) {
      return hasPerms() &&
        ('bookingOperations' in userPerms()) &&
        userPerms().bookingOperations is map
        ? userPerms().bookingOperations.get(key, defaultVal) == true
        : defaultVal;
    }

    function hasCmsFinanceAccess() {
      return hasPerms() && (
        userPerms().get('canAccessFinancials', false) == true ||
        (('cmsFinance' in userPerms()) && userPerms().cmsFinance is map && (
          userPerms().cmsFinance.get('enabled', false) == true ||
          userPerms().cmsFinance.get('pricing', false) == true
        ))
      );
    }

    function adminFinancialRevoked() {
      return hasPerms() && (
        userPerms().get('canAccessFinancials', true) == false ||
        (('cmsFinance' in userPerms()) && userPerms().cmsFinance is map && userPerms().cmsFinance.get('enabled', true) == false)
      );
    }

    // Strict RBAC for reading internal booking pricing snapshots & margin-funded discount history.
    // B2B Agents, Buyers, unapproved accounts, Admins with explicitly revoked financial access,
    // and Team Members without explicit financial/margin permissions are strictly denied.
    function canReadBookingFinancialSnapshots() {
      return isSuperAdmin() || (
        isApprovedUser() && hasUserDoc(request.auth.uid) && (
          (currentRole() == 'ADMIN' && (
            (!adminFinancialRevoked() && (
              hasBookingOpsPerm('view_internal_margin', true) ||
              hasBookingOpsPerm('apply_manual_discount', false) ||
              hasBookingOpsPerm('view_discount_reports', false) ||
              hasCmsFinanceAccess()
            )) ||
            (adminFinancialRevoked() && (
              hasBookingOpsPerm('view_internal_margin', false) ||
              hasBookingOpsPerm('apply_manual_discount', false) ||
              hasBookingOpsPerm('view_discount_reports', false)
            ))
          )) ||
          (currentRole() in ['TEAM_MEMBER', 'DMC_STAFF'] && (
            hasBookingOpsPerm('view_internal_margin', false) ||
            hasBookingOpsPerm('view_internal_financials', false) ||
            hasBookingOpsPerm('apply_manual_discount', false) ||
            hasBookingOpsPerm('apply_admin_coupon', false) ||
            hasBookingOpsPerm('view_discount_reports', false) ||
            hasCmsFinanceAccess()
          ))
        )
      );
    }

    // Strict RBAC for creating immutable pricing snapshots & manual discount adjustments.
    function canWriteBookingFinancialSnapshots() {
      return isSuperAdmin() || (
        isApprovedUser() && hasUserDoc(request.auth.uid) && (
          (currentRole() == 'ADMIN' && (
            (!adminFinancialRevoked() && (
              hasBookingOpsPerm('apply_manual_discount', true) ||
              hasBookingOpsPerm('apply_admin_coupon', true) ||
              hasBookingOpsPerm('reverse_manual_discount', true)
            )) ||
            (adminFinancialRevoked() && (
              hasBookingOpsPerm('apply_manual_discount', false) ||
              hasBookingOpsPerm('apply_admin_coupon', false) ||
              hasBookingOpsPerm('reverse_manual_discount', false)
            ))
          )) ||
          (currentRole() in ['TEAM_MEMBER', 'DMC_STAFF'] && (
            hasBookingOpsPerm('apply_manual_discount', false) ||
            hasBookingOpsPerm('apply_admin_coupon', false) ||
            hasBookingOpsPerm('reverse_manual_discount', false)
          ))
        )
      );
    }

    // Strict RBAC for creating versioned Payment Schedules & Instalment Tranches.
    function canManageBookingPaymentSchedules() {
      return isSuperAdmin() || (
        isApprovedUser() && hasUserDoc(request.auth.uid) && (
          (currentRole() == 'ADMIN' && (
            (!adminFinancialRevoked() && (
              hasBookingOpsPerm('manage_payment_schedule', true) ||
              hasBookingOpsPerm('apply_manual_discount', true) ||
              hasCmsFinanceAccess()
            )) ||
            (adminFinancialRevoked() && (
              hasBookingOpsPerm('manage_payment_schedule', false) ||
              hasBookingOpsPerm('apply_manual_discount', false)
            ))
          )) ||
          (currentRole() in ['TEAM_MEMBER', 'DMC_STAFF'] && (
            hasBookingOpsPerm('manage_payment_schedule', false) ||
            hasBookingOpsPerm('apply_manual_discount', false) ||
            hasCmsFinanceAccess()
          ))
        )
      );
    }

    // 1. User & Account Management Access
    function canManageUserAccounts() {
      return isMasterAdmin() || (
        isApprovedUser() && hasUserDoc(request.auth.uid) && (
          currentRole() in ['SUPER_ADMIN', 'ADMIN'] ||
          (hasPerms() && (
            userPerms().get('canManagePermissions', false) == true ||
            (('cmsFinance' in userPerms()) && userPerms().cmsFinance is map && (
              userPerms().cmsFinance.get('userAccounts', false) == true ||
              userPerms().cmsFinance.get('accountManagement', false) == true
            ))
          ))
        )
      );
    }

    // 2. CMS Operations Access (Products, Hotels, Packages, Bookings, Leads, Roster) — CEL null-safe
    function canAccessCMSOperations() {
      return isMasterAdmin() || (
        isApprovedUser() && hasUserDoc(request.auth.uid) && (
          currentRole() in ['SUPER_ADMIN', 'ADMIN', 'TEAM_MEMBER', 'DMC_STAFF']
        ) && (
          !hasPerms() ||
          !('cmsOperations' in userPerms()) ||
          !(userPerms().cmsOperations is map) ||
          userPerms().cmsOperations.get('enabled', true) != false
        )
      );
    }

    // 3. CMS Content Access (Pages, Marketing, FAQ, Destinations, Media, Menus, Footers) — CEL null-safe
    function canAccessCMSContent() {
      return isMasterAdmin() || (
        isApprovedUser() && hasUserDoc(request.auth.uid) && (
          currentRole() in ['SUPER_ADMIN', 'ADMIN', 'TEAM_MEMBER', 'DMC_STAFF']
        ) && (
          !hasPerms() ||
          !('cmsContent' in userPerms()) ||
          !(userPerms().cmsContent is map) ||
          userPerms().cmsContent.get('enabled', true) != false
        )
      );
    }

    // 4. CMS Financial Access (Invoices, Ledgers, Vouchers, Financial Reporting) — CEL null-safe
    function canAccessCMSFinance() {
      return isMasterAdmin() || (
        isApprovedUser() && hasUserDoc(request.auth.uid) && (
          currentRole() in ['SUPER_ADMIN', 'ADMIN'] ||
          hasCmsFinanceAccess()
        )
      );
    }

    // 5. CMS System Access (SLAs, Integrations, Audit Logs, Diagnostics)
    function canAccessCMSSystem() {
      return isMasterAdmin() || (
        isApprovedUser() && hasUserDoc(request.auth.uid) && (
          currentUserData().role == 'ADMIN' ||
          currentUserData().role == 'TEAM_MEMBER' ||
          currentUserData().role == 'DMC_STAFF'
        ) && (
          !('permissions' in currentUserData()) ||
          !('cmsSystem' in currentUserData().permissions) ||
          currentUserData().permissions.cmsSystem.enabled != false
        )
      );
    }

    // 6. B2B Wholesale Inventory & Quote Builder Access (Strict B2B Agent, Agency Owner & Internal Staff Only)
    function canAccessB2BInventory() {
      return isMasterAdmin() || (
        isApprovedUser() && (
          currentUserData().role == 'SUPER_ADMIN' ||
          currentUserData().role == 'ADMIN' ||
          currentUserData().role == 'TEAM_MEMBER' ||
          currentUserData().role == 'DMC_STAFF' ||
          currentUserData().role == 'AGENCY_OWNER' ||
          currentUserData().role == 'B2B_AGENT' ||
          currentUserData().role == 'AGENT'
        ) && (
          !('permissions' in currentUserData()) ||
          currentUserData().permissions.b2bQuoteBuilderAccess != false
        )
      );
    }

    function canAccessB2BQuotes() {
      return canAccessB2BInventory();
    }

    // 7. System Analysis Access (User Analytics & Complete Journey Tracking)
    function canAccessSystemAnalysis() {
      return isMasterAdmin() || (
        isApprovedUser() && (
          currentUserData().role == 'ADMIN' ||
          currentUserData().role == 'TEAM_MEMBER' ||
          (hasPerms() && (
            userPerms().canAccessCMS == true && (
              !('cmsSystemAnalysis' in userPerms()) ||
              userPerms().cmsSystemAnalysis.view != false
            )
          ))
        )
      );
    }

    // 8. Tasks & Follow-Ups Access Control
    function canManageCalendarTasks() {
      return isMasterAdmin() || (
        isApprovedUser() && hasUserDoc(request.auth.uid) && (
          currentUserData().role == 'ADMIN' ||
          currentUserData().role == 'TEAM_MEMBER' ||
          currentUserData().role == 'DMC_STAFF' ||
          currentUserData().userType == 'ADMIN' ||
          currentUserData().userType == 'TEAM_MEMBER'
        ) && (
          !hasPerms() ||
          userPerms().tasksView != false
        )
      );
    }

    function canCreateCalendarTasks() {
      return isMasterAdmin() || (
        isApprovedUser() && hasUserDoc(request.auth.uid) && (
          currentUserData().role == 'ADMIN' ||
          currentUserData().role == 'TEAM_MEMBER' ||
          currentUserData().role == 'DMC_STAFF' ||
          currentUserData().userType == 'ADMIN' ||
          currentUserData().userType == 'TEAM_MEMBER'
        ) && (
          !hasPerms() ||
          userPerms().tasksCreate != false
        )
      );
    }

    function canEditCalendarTasks() {
      return isMasterAdmin() || (
        isApprovedUser() && hasUserDoc(request.auth.uid) && (
          currentUserData().role == 'ADMIN' ||
          currentUserData().role == 'TEAM_MEMBER' ||
          currentUserData().role == 'DMC_STAFF' ||
          currentUserData().userType == 'ADMIN' ||
          currentUserData().userType == 'TEAM_MEMBER'
        ) && (
          !hasPerms() ||
          userPerms().tasksEdit != false
        )
      );
    }

    function canCompleteCalendarTasks() {
      return isMasterAdmin() || (
        isApprovedUser() && hasUserDoc(request.auth.uid) && (
          currentUserData().role == 'ADMIN' ||
          currentUserData().role == 'TEAM_MEMBER' ||
          currentUserData().role == 'DMC_STAFF' ||
          currentUserData().userType == 'ADMIN' ||
          currentUserData().userType == 'TEAM_MEMBER'
        ) && (
          !hasPerms() ||
          userPerms().tasksComplete != false
        )
      );
    }

    function canDeleteCalendarTasks() {
      return isMasterAdmin() || (
        isApprovedUser() && hasUserDoc(request.auth.uid) && (
          currentUserData().role == 'ADMIN' ||
          (hasPerms() && userPerms().tasksDelete == true)
        )
      );
    }

    // =========================================================================
    // USER ACCOUNTS & PERMISSION PROFILES (Field-Level Security Enforced)
    // =========================================================================

    function isValidAccountManagerAssignmentHistory(data, historyId) {
      return data != null &&
        data.keys().hasAll([
          'id',
          'agentUid',
          'agentName',
          'newAccountManagerUid',
          'newAccountManagerName',
          'action',
          'performedByUid',
          'performedByName',
          'timestamp'
        ]) &&
        data.keys().hasOnly([
          'id',
          'agentUid',
          'agentName',
          'agentEmail',
          'agencyId',
          'agencyName',
          'previousAccountManagerUid',
          'previousAccountManagerName',
          'previousAccountManagerEmail',
          'newAccountManagerUid',
          'newAccountManagerName',
          'newAccountManagerEmail',
          'newAccountManagerDesignation',
          'action',
          'performedByUid',
          'performedByName',
          'performedByEmail',
          'performedByRole',
          'reason',
          'timestamp'
        ]) &&
        data.id is string && data.id == historyId &&
        data.agentUid is string && data.agentUid.size() > 0 && data.agentUid.size() <= 128 &&
        data.agentName is string && data.agentName.size() > 0 && data.agentName.size() <= 200 &&
        data.newAccountManagerUid is string && data.newAccountManagerUid.size() > 0 && data.newAccountManagerUid.size() <= 128 &&
        data.newAccountManagerName is string && data.newAccountManagerName.size() > 0 && data.newAccountManagerName.size() <= 200 &&
        data.action in ['ASSIGNED', 'REASSIGNED'] &&
        data.performedByUid is string && data.performedByUid.size() > 0 && data.performedByUid.size() <= 128 &&
        data.performedByName is string && data.performedByName.size() > 0 && data.performedByName.size() <= 200 &&
        data.timestamp is string && data.timestamp.size() > 0 && data.timestamp.size() <= 64 &&
        (!('reason' in data) || data.reason == null || (data.reason is string && data.reason.size() <= 1000));
    }

    match /users/{userId} {
      // Authenticated user can read only their own profile (or email lookup during own session),
      // while internal staff can read user directory. B2B Agents cannot inspect other users' assignments.
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        isInternalUser() ||
        ('email' in request.auth.token && 'email' in resource.data && resource.data.email == request.auth.token.email.lower())
      );
      
      // User can create their own document on registration, or Admin CMS can provision accounts.
      // Strictly reject BUYER role creation and self-assignment of Account Managers.
      allow create: if canManageUserAccounts() || isValidAdminCMSData() || (
        isAuthenticated() && request.auth.uid == userId && (
          request.resource.data.role != 'BUYER' &&
          (!('userType' in request.resource.data) || request.resource.data.userType != 'BUYER') &&
          !request.resource.data.keys().hasAny([
            'accountManagerUid',
            'accountManagerName',
            'accountManagerEmail',
            'accountManagerDesignation',
            'accountManagerPhone',
            'accountManagerAssignedAt',
            'accountManagerAssignedBy',
            'accountManagerAssignedByName',
            'accountManagerUpdatedAt'
          ]) &&
          (!('accountManagerAssignmentStatus' in request.resource.data) || request.resource.data.accountManagerAssignmentStatus == 'UNASSIGNED')
        )
      );

      // Update: Admin / Account Management can update all fields (roles, permissions, approvals, pricingSettings, accountManager*).
      // Self-updates are allowed ONLY if privilege, pricingSettings, and Account Manager fields remain untouched.
      allow update: if canManageUserAccounts() || isValidAdminCMSData() || (
        isAuthenticated() && request.auth.uid == userId && isNotBuyer() &&
        request.resource.data.role != 'BUYER' &&
        (!('userType' in request.resource.data) || request.resource.data.userType != 'BUYER') &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role',
          'permissions',
          'approvalStatus',
          'pricingSettings',
          'customAgentMarginPercent',
          'agentLevelMarginPercent',
          'productLevelMarginEnabled',
          'activeMarginMode',
          'accountManagerUid',
          'accountManagerName',
          'accountManagerEmail',
          'accountManagerDesignation',
          'accountManagerPhone',
          'accountManagerAssignedAt',
          'accountManagerAssignedBy',
          'accountManagerAssignedByName',
          'accountManagerUpdatedAt',
          'accountManagerAssignmentStatus'
        ])
      );

      // Deletion strictly reserved for Administrators
      allow delete: if canManageUserAccounts() || isValidAdminCMSData() || isResourceAdminOwned();
    }

    // Immutable append-only audit trail for user-level B2B Agent Account Manager assignments
    match /account_manager_assignment_history/{historyId} {
      allow get: if isAuthenticated() && isValidId(historyId) && (
        canManageUserAccounts() ||
        (isInternalUser() && resource != null && (
          resource.data.newAccountManagerUid == request.auth.uid ||
          resource.data.previousAccountManagerUid == request.auth.uid
        ))
      );
      allow list: if isAuthenticated() && (
        canManageUserAccounts() ||
        (isInternalUser() && (
          resource.data.newAccountManagerUid == request.auth.uid ||
          resource.data.previousAccountManagerUid == request.auth.uid
        ))
      );
      allow create: if isAuthenticated() &&
        isValidId(historyId) &&
        canManageUserAccounts() &&
        isValidAccountManagerAssignmentHistory(request.resource.data, historyId);
      allow update, delete: if false;
    }

    match /companies/{companyId} {
      // Authenticated business users can read company profiles
      allow read: if isAuthenticated();
      // Write: Admins and internal staff with Account Management access have full control;
      // External agency users can update their company profile ONLY if pricingSettings is untouched
      allow create: if canManageUserAccounts() || isInternalUser() || isValidAdminCMSData() || isAuthenticated();
      allow update: if canManageUserAccounts() || isInternalUser() || isValidAdminCMSData() || (
        isAuthenticated() && isNotBuyer() && (
          (resource.data.primaryContactUserId == request.auth.uid) ||
          (request.auth.uid in resource.data.linkedUserIds)
        ) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'pricingSettings',
          'customAgentMarginPercent',
          'agentLevelMarginPercent',
          'productLevelMarginEnabled',
          'activeMarginMode'
        ])
      );
      allow delete: if canManageUserAccounts() || isValidAdminCMSData() || isResourceAdminOwned();
    }

    match /system_users/{userId} {
      allow read: if isInternalUser();
      allow write: if canManageUserAccounts();
    }

    // =========================================================================
    // AUTHORITATIVE INVENTORY TOMBSTONES & DEACTIVATION REGISTRY
    // Read: All authenticated & verified systems | Write: Authorized CMS Operations
    // =========================================================================
    match /inventory_tombstones/{document=**} {
      allow read: if true;
      allow create, update: if isMasterAdmin() || canAccessCMSOperations() || canAccessCMSContent() || isAuthenticated() || isValidAdminCMSData();
      allow delete: if isMasterAdmin() || canAccessCMSOperations() || canAccessCMSContent() || isAuthenticated() || isResourceAdminOwned();
    }

    // =========================================================================
    // CMS MASTER OPERATIONAL DATA (Products, Hotels, Tariffs, Packages, Visas)
    // Read: Public Catalog / Verified Agents | Write/Delete: Strictly Authorized Internal Users
    // =========================================================================

    match /products/{document=**} {
      allow read: if true;
      allow create, update: if canAccessCMSOperations() || canAccessCMSFinance() || isValidAdminCMSData();
      allow delete: if canAccessCMSOperations() || isResourceAdminOwned();
    }

    match /image_metadata/{document=**} {
      allow read: if true;
      allow create, update: if canAccessCMSOperations() || isValidAdminCMSData();
      allow delete: if canAccessCMSOperations() || isResourceAdminOwned();
    }

    match /master_vehicles/{document=**} {
      allow read: if true;
      allow create, update: if canAccessCMSOperations() || isValidAdminCMSData();
      allow delete: if canAccessCMSOperations() || isResourceAdminOwned();
    }

    match /master_yachts/{document=**} {
      allow read: if true;
      allow create, update: if canAccessCMSOperations() || isValidAdminCMSData();
      allow delete: if canAccessCMSOperations() || isResourceAdminOwned();
    }

    match /master_ferries/{document=**} {
      allow read: if true;
      allow create, update: if canAccessCMSOperations() || isValidAdminCMSData();
      allow delete: if canAccessCMSOperations() || isResourceAdminOwned();
    }

    match /japan_rail_commercial_products/{document=**} {
      allow read: if true;
      allow create, update: if canAccessCMSOperations() || canAccessCMSFinance() || isValidAdminCMSData();
      allow delete: if canAccessCMSOperations() || isResourceAdminOwned();
    }

    match /product_pricing_rates/{document=**} {
      allow read: if true;
      allow create, update: if canAccessCMSOperations() || isValidAdminCMSData();
      allow delete: if canAccessCMSOperations() || isResourceAdminOwned();
    }

    match /product_capacities/{document=**} {
      allow read: if true;
      allow create, update: if canAccessCMSOperations() || isValidAdminCMSData();
      allow delete: if canAccessCMSOperations() || isResourceAdminOwned();
    }

    match /hotels/{document=**} {
      allow read: if true;
      allow create, update: if canAccessCMSOperations() || isValidAdminCMSData();
      allow delete: if canAccessCMSOperations() || isResourceAdminOwned();
    }

    match /hotel_rooms/{document=**} {
      allow read: if true;
      allow create, update: if canAccessCMSOperations() || isValidAdminCMSData();
      allow delete: if canAccessCMSOperations() || isResourceAdminOwned();
    }

    match /hotel_rates/{document=**} {
      allow read: if true;
      allow create, update: if canAccessCMSOperations() || isValidAdminCMSData();
      allow delete: if canAccessCMSOperations() || isResourceAdminOwned();
    }

    match /hotel_meal_plans/{document=**} {
      allow read: if true;
      allow create, update: if canAccessCMSOperations() || isValidAdminCMSData();
      allow delete: if canAccessCMSOperations() || isResourceAdminOwned();
    }

    match /transfer_routes/{document=**} {
      allow read: if true;
      allow create, update: if canAccessCMSOperations() || isValidAdminCMSData();
      allow delete: if canAccessCMSOperations() || isResourceAdminOwned();
    }

    match /transfer_rates/{document=**} {
      allow read: if true;
      allow create, update: if canAccessCMSOperations() || isValidAdminCMSData();
      allow delete: if canAccessCMSOperations() || isResourceAdminOwned();
    }

    match /b2b_packages/{document=**} {
      allow read: if true;
      allow create, update: if (canAccessCMSOperations() || isValidAdminCMSData()) &&
        (!('licensedGuideIncluded' in request.resource.data) || request.resource.data.licensedGuideIncluded is bool);
      allow delete: if canAccessCMSOperations() || isResourceAdminOwned();
    }

    match /package_items/{document=**} {
      allow read: if true;
      allow create, update: if canAccessCMSOperations() || isValidAdminCMSData();
      allow delete: if canAccessCMSOperations() || isResourceAdminOwned();
    }

    match /visas/{document=**} {
      allow read: if true;
      allow create, update, delete: if canAccessCMSOperations();
    }

    match /travel_protection_plans/{document=**} {
      allow read: if true;
      allow create, update: if canAccessCMSOperations() || isValidAdminCMSData();
      allow delete: if canAccessCMSOperations() || isResourceAdminOwned();
    }

    match /vip_ground_services/{document=**} {
      allow read: if true;
      allow create, update: if canAccessCMSOperations() || isValidAdminCMSData();
      allow delete: if canAccessCMSOperations() || isResourceAdminOwned();
    }

    match /connectivity_plans/{document=**} {
      allow read: if true;
      allow create, update: if canAccessCMSOperations() || isValidAdminCMSData();
      allow delete: if canAccessCMSOperations() || isResourceAdminOwned();
    }

    match /visa_rates/{document=**} {
      allow read: if true;
      allow create, update: if canAccessCMSOperations() || isValidAdminCMSData();
      allow delete: if canAccessCMSOperations() || isResourceAdminOwned();
    }

    // =========================================================================
    // JAPAN RAIL INVENTORY & DYNAMIC PRICING ENGINE
    // =========================================================================
    match /rail_stations/{document=**} {
      allow read: if true;
      allow create, update: if canAccessCMSOperations() || isValidAdminCMSData();
      allow delete: if canAccessCMSOperations() || isResourceAdminOwned();
    }

    match /rail_routes/{document=**} {
      allow read: if true;
      allow create, update: if canAccessCMSOperations() || isValidAdminCMSData();
      allow delete: if canAccessCMSOperations() || isResourceAdminOwned();
    }

    match /rail_rates/{document=**} {
      allow read: if true;
      allow create, update: if canAccessCMSOperations() || isValidAdminCMSData();
      allow delete: if canAccessCMSOperations() || isResourceAdminOwned();
    }

    match /rail_markup_rules/{document=**} {
      allow read: if true;
      allow create, update: if canAccessCMSOperations() || isValidAdminCMSData();
      allow delete: if canAccessCMSOperations() || isResourceAdminOwned();
    }

    match /rail_seasons/{document=**} {
      allow read: if true;
      allow create, update: if canAccessCMSOperations() || isValidAdminCMSData();
      allow delete: if canAccessCMSOperations() || isResourceAdminOwned();
    }

    // =========================================================================
    // CMS CONTENT & DESTINATIONS & INSTITUTIONAL CMS
    // Read: Public Content | Write/Delete: Strictly Authorized Content Managers
    // =========================================================================

    match /destinations/{document=**} {
      allow read: if true;
      allow create, update: if canAccessCMSContent() || isValidAdminCMSData();
      allow delete: if canAccessCMSContent() || isResourceAdminOwned();
    }

    match /regions/{document=**} {
      allow read: if true;
      allow create, update: if canAccessCMSContent() || isValidAdminCMSData();
      allow delete: if canAccessCMSContent() || isResourceAdminOwned();
    }

    match /city_hubs/{document=**} {
      allow read: if true;
      allow create, update: if canAccessCMSContent() || isValidAdminCMSData();
      allow delete: if canAccessCMSContent() || isResourceAdminOwned();
    }

    match /master_regions/{document=**} {
      allow read: if true;
      allow create, update: if canAccessCMSContent() || isValidAdminCMSData();
      allow delete: if canAccessCMSContent() || isResourceAdminOwned();
    }

    match /faqs/{document=**} {
      allow read: if true;
      allow create, update: if canAccessCMSContent() || isValidAdminCMSData();
      allow delete: if canAccessCMSContent() || isResourceAdminOwned();
    }

    match /destination_faqs/{document=**} {
      allow read: if true;
      allow create, update: if canAccessCMSContent() || isValidAdminCMSData();
      allow delete: if canAccessCMSContent() || isResourceAdminOwned();
    }

    match /custom_pages/{document=**} {
      allow read: if true;
      allow create, update: if canAccessCMSContent() || isValidAdminCMSData();
      allow delete: if canAccessCMSContent() || isResourceAdminOwned();
    }

    // Destination-Wise Commercial Quotation Terms (Admin CMS Controlled, B2B Read Published Only)
    match /destination_commercial_terms/{configId} {
      allow read: if canAccessCMSContent() || isMasterAdmin() || resource == null || (
        resource.data.status == 'PUBLISHED' && resource.data.isActive == true
      );
      allow create, update: if canAccessCMSContent() || isMasterAdmin() || isValidAdminCMSData();
      allow delete: if canAccessCMSContent() || isMasterAdmin() || isResourceAdminOwned();
    }

    match /destination_commercial_terms_history/{versionId} {
      allow read: if canAccessCMSContent() || isMasterAdmin();
      allow create: if canAccessCMSContent() || isMasterAdmin() || isValidAdminCMSData();
      allow update, delete: if isMasterAdmin();
    }

    match /menu_items/{document=**} {
      allow read: if true;
      allow write: if canAccessCMSContent();
    }

    match /footer_config/{document=**} {
      allow read: if true;
      allow write: if canAccessCMSContent();
    }

    function isValidPromotionData(data) {
      return data != null &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        (!('promoCode' in data) || data.promoCode == null || (data.promoCode is string && data.promoCode.size() <= 64)) &&
        (!('normalizedPromoCode' in data) || data.normalizedPromoCode == null || (data.normalizedPromoCode is string && data.normalizedPromoCode.size() <= 64)) &&
        (!('internalAdminNotes' in data) || data.internalAdminNotes == null || (data.internalAdminNotes is string && data.internalAdminNotes.size() <= 4000)) &&
        data.discountType in ['PERCENTAGE', 'FIXED'] &&
        (data.discountValue is int || data.discountValue is float) &&
        data.discountValue >= 0 &&
        (data.discountType != 'PERCENTAGE' || data.discountValue <= 100) &&
        (!('status' in data) || data.status in ['DRAFT', 'SCHEDULED', 'ACTIVE', 'PAUSED', 'EXPIRED', 'DISABLED', 'ARCHIVED']) &&
        (!('couponChannel' in data) || data.couponChannel == null || data.couponChannel in ['B2B_AGENT', 'ADMIN_MANUAL', 'BOTH']) &&
        (!('fundingSource' in data) || data.fundingSource == null || data.fundingSource in ['THEUNBOUND_MARGIN', 'MARKETING_BUDGET', 'SHARED']) &&
        (!('permittedForExistingBookings' in data) || data.permittedForExistingBookings == null || data.permittedForExistingBookings is bool) &&
        (!('requiresAdminApproval' in data) || data.requiresAdminApproval == null || data.requiresAdminApproval is bool);
    }

    function isValidBookingPricingSnapshotCreate(data, snapId) {
      return isValidId(snapId) &&
        data != null &&
        data.snapshotId == snapId &&
        data.bookingId is string && data.bookingId.size() > 0 && data.bookingId.size() <= 128 &&
        data.version is int && data.version >= 1 &&
        data.currency is string && data.currency.size() > 0 && data.currency.size() <= 8 &&
        (data.supplierNettCost is int || data.supplierNettCost is float) && data.supplierNettCost >= 0 &&
        (data.originalBaseSellingPrice is int || data.originalBaseSellingPrice is float) && data.originalBaseSellingPrice >= 0 &&
        (data.originalCustomerSellingPrice is int || data.originalCustomerSellingPrice is float) && data.originalCustomerSellingPrice >= 0 &&
        (data.originalTheUnboundMargin is int || data.originalTheUnboundMargin is float) &&
        (data.b2bPromotionDiscountAmount is int || data.b2bPromotionDiscountAmount is float) && data.b2bPromotionDiscountAmount >= 0 &&
        (data.cumulativeAdminManualDiscount is int || data.cumulativeAdminManualDiscount is float) && data.cumulativeAdminManualDiscount >= 0 &&
        (data.remainingTheUnboundMargin is int || data.remainingTheUnboundMargin is float) &&
        (data.revisedCustomerSellingPrice is int || data.revisedCustomerSellingPrice is float) && data.revisedCustomerSellingPrice >= 0 &&
        data.sourceAction in ['INITIAL_BOOKING', 'ADMIN_MANUAL_DISCOUNT_APPLIED', 'ADMIN_MANUAL_DISCOUNT_REVERSED', 'PROFORMA_INVOICE_REVISION'] &&
        data.immutable == true;
    }

    function isValidBookingPaymentScheduleCreate(data, scheduleId) {
      return isValidId(scheduleId) &&
        data != null &&
        data.scheduleId == scheduleId &&
        data.bookingId is string && data.bookingId.size() > 0 && data.bookingId.size() <= 128 &&
        data.scheduleVersion is int && data.scheduleVersion >= 1 &&
        data.financialSnapshotId is string && data.financialSnapshotId.size() > 0 && data.financialSnapshotId.size() <= 160 &&
        data.financialSnapshotVersion is int && data.financialSnapshotVersion >= 1 &&
        data.currency is string && data.currency.size() > 0 && data.currency.size() <= 8 &&
        (data.originalBookingAmount is int || data.originalBookingAmount is float) && data.originalBookingAmount >= 0 &&
        (data.totalDiscountAmount is int || data.totalDiscountAmount is float) && data.totalDiscountAmount >= 0 &&
        (data.revisedBookingAmount is int || data.revisedBookingAmount is float) && data.revisedBookingAmount >= 0 &&
        (data.totalAmount is int || data.totalAmount is float) && data.totalAmount >= 0 &&
        (data.totalPaid is int || data.totalPaid is float) && data.totalPaid >= 0 &&
        (data.balanceDue is int || data.balanceDue is float) && data.balanceDue >= 0 &&
        data.installments is list && data.installments.size() >= 1 && data.installments.size() <= 50 &&
        data.scheduleStatus in ['ACTIVE', 'RECALCULATION_REQUIRED', 'SUPERSEDED', 'PARTIAL'] &&
        data.createdBy is string && data.createdBy.size() > 0 && data.createdBy.size() <= 128 &&
        data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 64 &&
        data.immutable == true;
    }

    function isValidBookingManualDiscountCreate(data, adjId) {
      return isValidId(adjId) &&
        data != null &&
        data.adjustmentId == adjId &&
        data.bookingId is string && data.bookingId.size() > 0 && data.bookingId.size() <= 128 &&
        data.actionType in ['APPLY', 'REVERSE'] &&
        data.discountSource in ['ADMIN_MANUAL_COUPON', 'ADMIN_MANUAL_ADJUSTMENT'] &&
        data.fundingSource == 'THEUNBOUND_MARGIN' &&
        data.discountType in ['FIXED', 'PERCENTAGE'] &&
        (data.discountValue is int || data.discountValue is float) && data.discountValue > 0 &&
        (data.discountAmountInBookingCurrency is int || data.discountAmountInBookingCurrency is float) && data.discountAmountInBookingCurrency > 0 &&
        data.reason is string && data.reason.size() >= 3 && data.reason.size() <= 1000 &&
        (!('couponCode' in data) || data.couponCode == null || (data.couponCode is string && data.couponCode.size() <= 64)) &&
        (!('internalNotes' in data) || data.internalNotes == null || (data.internalNotes is string && data.internalNotes.size() <= 2000)) &&
        (!('marginOverrideReason' in data) || data.marginOverrideReason == null || (data.marginOverrideReason is string && data.marginOverrideReason.size() <= 1000)) &&
        data.previousSnapshotId is string && data.previousSnapshotId.size() > 0 && data.previousSnapshotId.size() <= 160 &&
        data.resultingSnapshotId is string && data.resultingSnapshotId.size() > 0 && data.resultingSnapshotId.size() <= 160 &&
        data.immutable == true;
    }

    function isValidPromotionReservationCreate(data, resId) {
      return isValidId(resId) &&
        data != null &&
        data.id == resId &&
        data.promotionId is string && data.promotionId.size() > 0 && data.promotionId.size() <= 128 &&
        data.code is string && data.code.size() > 0 && data.code.size() <= 64 &&
        data.normalizedCode is string && data.normalizedCode.size() > 0 && data.normalizedCode.size() <= 64 &&
        data.quotationId is string && data.quotationId.size() > 0 && data.quotationId.size() <= 128 &&
        data.agentUid is string && data.agentUid == request.auth.uid &&
        data.idempotencyKey is string && data.idempotencyKey.size() > 0 && data.idempotencyKey.size() <= 200 &&
        (data.discountAmount is int || data.discountAmount is float) && data.discountAmount >= 0 &&
        (data.preDiscountBaseSellingPrice is int || data.preDiscountBaseSellingPrice is float) && data.preDiscountBaseSellingPrice >= 0 &&
        (data.discountedBaseSellingPrice is int || data.discountedBaseSellingPrice is float) && data.discountedBaseSellingPrice >= 0 &&
        data.status == 'RESERVED';
    }

    function isValidPromotionReservationAgentUpdate(data, prev, resId) {
      return isValidId(resId) &&
        prev != null &&
        data != null &&
        prev.status == 'RESERVED' &&
        prev.agentUid == request.auth.uid &&
        data.agentUid == prev.agentUid &&
        data.promotionId == prev.promotionId &&
        data.quotationId == prev.quotationId &&
        data.discountAmount == prev.discountAmount &&
        data.status in ['COMMITTED', 'RELEASED', 'EXPIRED'] &&
        data.diff(prev).affectedKeys().hasOnly(['status', 'committedAt', 'releasedAt', 'bookingId', 'bookingReference', 'updatedAt']);
    }

    function isValidPromotionRedemptionCreate(data, redId) {
      return isValidId(redId) &&
        data != null &&
        data.id == redId &&
        data.promotionId is string && data.promotionId.size() > 0 && data.promotionId.size() <= 128 &&
        data.code is string && data.code.size() > 0 && data.code.size() <= 64 &&
        data.bookingId is string && data.bookingId.size() > 0 && data.bookingId.size() <= 128 &&
        data.quotationId is string && data.quotationId.size() > 0 && data.quotationId.size() <= 128 &&
        data.agentUid is string && data.agentUid == request.auth.uid &&
        data.idempotencyKey is string && data.idempotencyKey.size() > 0 && data.idempotencyKey.size() <= 200 &&
        (data.discountAmount is int || data.discountAmount is float) && data.discountAmount >= 0 &&
        (data.discountedBaseSellingPrice is int || data.discountedBaseSellingPrice is float) && data.discountedBaseSellingPrice >= 0 &&
        data.status == 'REDEEMED' &&
        data.appliedStage in ['QUOTATION', 'BOOKING_CONFIRMATION'];
    }

    match /promotions/{promoId} {
      allow read: if true;
      allow create, update: if isValidId(promoId) &&
        (canAccessCMSContent() || isMasterAdmin()) &&
        isValidPromotionData(request.resource.data);
      allow delete: if isValidId(promoId) && (canAccessCMSContent() || isMasterAdmin());
    }

    match /promotion_reservations/{reservationId} {
      allow get: if isValidId(reservationId) && (
        canAccessCMSContent() || isMasterAdmin() ||
        (isAuthenticated() && resource.data.agentUid == request.auth.uid)
      );
      allow list: if canAccessCMSContent() || isMasterAdmin() ||
        (isAuthenticated() && resource.data.agentUid == request.auth.uid);
      allow create: if isValidId(reservationId) && (
        (canAccessCMSContent() || isMasterAdmin()) ||
        (isApprovedUser() && isValidPromotionReservationCreate(request.resource.data, reservationId))
      );
      allow update: if isValidId(reservationId) && (
        (canAccessCMSContent() || isMasterAdmin()) ||
        (isApprovedUser() && isValidPromotionReservationAgentUpdate(request.resource.data, resource.data, reservationId))
      );
      allow delete: if isValidId(reservationId) && (canAccessCMSContent() || isMasterAdmin());
    }

    match /promotion_redemptions/{redemptionId} {
      allow get: if isValidId(redemptionId) && (
        canAccessCMSContent() || isMasterAdmin() ||
        (isAuthenticated() && resource.data.agentUid == request.auth.uid)
      );
      allow list: if canAccessCMSContent() || isMasterAdmin() ||
        (isAuthenticated() && resource.data.agentUid == request.auth.uid);
      allow create: if isValidId(redemptionId) && (
        (canAccessCMSContent() || isMasterAdmin()) ||
        (isApprovedUser() && isValidPromotionRedemptionCreate(request.resource.data, redemptionId))
      );
      allow update, delete: if isValidId(redemptionId) && (canAccessCMSContent() || isMasterAdmin());
    }

    // Strictly Authorised Financial Staff Append-Only Booking Pricing Snapshots (Never readable by B2B Agents/Buyers or unauthorised staff)
    match /booking_pricing_snapshots/{snapshotId} {
      allow get: if isValidId(snapshotId) && canReadBookingFinancialSnapshots();
      allow list: if canReadBookingFinancialSnapshots();
      allow create: if isValidId(snapshotId) &&
        canWriteBookingFinancialSnapshots() &&
        isValidBookingPricingSnapshotCreate(request.resource.data, snapshotId);
      allow update, delete: if false;
    }

    // Strictly Authorised Financial Staff Append-Only Booking Manual Discount Ledger (Immutable — Reversals create new REVERSE records)
    match /booking_manual_discounts/{adjustmentId} {
      allow get: if isValidId(adjustmentId) && canReadBookingFinancialSnapshots();
      allow list: if canReadBookingFinancialSnapshots();
      allow create: if isValidId(adjustmentId) &&
        canWriteBookingFinancialSnapshots() &&
        isValidBookingManualDiscountCreate(request.resource.data, adjustmentId);
      allow update, delete: if false;
    }

    // Strictly Versioned Append-Only Booking Payment Schedules (Linked to Authoritative Financial Snapshot Version)
    match /booking_payment_schedules/{scheduleId} {
      allow get: if isValidId(scheduleId) && (canReadBookingFinancialSnapshots() || canManageBookingPaymentSchedules());
      allow list: if canReadBookingFinancialSnapshots() || canManageBookingPaymentSchedules();
      allow create: if isValidId(scheduleId) &&
        canManageBookingPaymentSchedules() &&
        isValidBookingPaymentScheduleCreate(request.resource.data, scheduleId);
      allow update, delete: if false;
    }

    match /gallery_items/{document=**} {
      allow read: if true;
      allow create, update: if canAccessCMSContent() || isValidAdminCMSData();
      allow delete: if canAccessCMSContent() || isResourceAdminOwned();
    }

    match /image_metadata/{document=**} {
      allow read: if true;
      allow create, update: if canAccessCMSContent() || isValidAdminCMSData();
      allow delete: if canAccessCMSContent() || isResourceAdminOwned();
    }

    match /google_reviews/{document=**} {
      allow read: if true;
      allow create, update: if canAccessCMSContent() || isValidAdminCMSData();
      allow delete: if canAccessCMSContent() || isResourceAdminOwned();
    }

    match /blog_articles/{document=**} {
      allow read: if true;
      allow create, update: if canAccessCMSContent() || isValidAdminCMSData();
      allow delete: if canAccessCMSContent() || isResourceAdminOwned();
    }

    match /homepage_config/{document=**} {
      allow read: if true;
      allow write: if canAccessCMSContent();
    }

    match /associated_partners/{document=**} {
      allow read: if true;
      allow create, update: if canAccessCMSContent() || isValidAdminCMSData();
      allow delete: if canAccessCMSContent() || isResourceAdminOwned();
    }

    match /site_pages_config/{document=**} {
      allow read: if true;
      allow write: if canAccessCMSContent();
    }

    match /company_profile/{document=**} {
      allow read: if true;
      allow write: if canAccessCMSContent() || isMasterAdmin();
    }

    match /campaigns/{document=**} {
      allow read: if true;
      allow create, update: if canAccessCMSContent() || isValidAdminCMSData() || isAuthenticated();
      allow delete: if canAccessCMSContent() || isResourceAdminOwned();
    }

    match /campaign_events/{document=**} {
      allow read: if canAccessCMSContent() || isAuthenticated();
      allow create: if true; // Public analytics telemetry
      allow update, delete: if isMasterAdmin() || canAccessCMSContent();
    }

    match /automation_jobs/{document=**} {
      allow read: if canAccessCMSContent() || isAuthenticated();
      allow create, update: if true;
      allow delete: if canAccessCMSContent() || isMasterAdmin();
    }

    match /automation_logs/{document=**} {
      allow read: if canAccessCMSContent() || isAuthenticated();
      allow create, update: if true;
      allow delete: if canAccessCMSContent() || isMasterAdmin();
    }

    match /automation_idempotency/{document=**} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if canAccessCMSContent() || isMasterAdmin();
    }

    // =========================================================================
    // LEADS & INQUIRIES
    // Guests can create inquiry; External users view own leads; Internal users manage all
    // =========================================================================

    match /leads/{leadId} {
      // Guests / Public can submit inquiries; authenticated users can create
      allow create: if true;

      // Internal team can read all leads; B2B Agents can ONLY read leads explicitly submitted by them or assigned to them
      allow read: if canAccessCMSOperations() || (
        isAuthenticated() && isNotBuyer() && (
          resource.data.assignedAgentId == request.auth.uid ||
          resource.data.responsibleAgentId == request.auth.uid ||
          resource.data.submittingAgentId == request.auth.uid ||
          resource.data.userId == request.auth.uid
        )
      );

      // Updates: Internal operations team has full control; assigned/responsible agent can update without modifying protected ownership/assignment metadata
      allow update: if canAccessCMSOperations() || (
        isAuthenticated() && isNotBuyer() && (
          (resource.data.assignedAgentId == request.auth.uid || 
           resource.data.responsibleAgentId == request.auth.uid || 
           resource.data.submittingAgentId == request.auth.uid) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'assignedAgentId',
            'assignedAgentNameSnapshot',
            'assignedAgentEmailSnapshot',
            'assignedAgentAgencySnapshot',
            'responsibleAgentId',
            'responsibleAgentNameSnapshot',
            'responsibleAgentEmailSnapshot',
            'responsibleAgentAgencySnapshot',
            'submittingAgentId',
            'submittingAgentNameSnapshot',
            'submittingAgentAgencySnapshot',
            'submittingAgentEmailSnapshot',
            'agentAssignmentStatus',
            'assignedTeamMemberId',
            'assignedTeamMemberNameSnapshot',
            'assignedTeamMemberEmailSnapshot',
            'assignedStaffId',
            'assignedStaffName',
            'assignedStaffEmail',
            'assignedDepartment',
            'assignmentStatus',
            'assignedByUserId',
            'assignedByUserNameSnapshot',
            'assignedAt',
            'lastReassignedAt',
            'lastReassignedByUserId',
            'lastReassignedByUserNameSnapshot',
            'assignmentNotes',
            'assignmentHistory',
            'leadVisibilityStatus'
          ])
        )
      );

      // Deletion is strictly reserved for Authorized Internal Operations
      allow delete: if canAccessCMSOperations() || isValidAdminCMSData() || isResourceAdminOwned();
    }

    match /lead_stages/{stageId} {
      // Internal operations can configure stages; authenticated internal users can read
      allow read: if isAuthenticated();
      allow write: if canAccessCMSOperations();
    }

    // =========================================================================
    // QUOTATIONS & BOOKINGS (Ownership Isolation)
    // =========================================================================

    match /quotations/{quotationId} {
      // Internal users can read all; External users only read own or public shares
      allow read: if canAccessCMSOperations() || (
        isAuthenticated() && (
          resource.data.agentId == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          resource.data.buyerId == request.auth.uid ||
          resource.data.isPublicShare == true ||
          resource.data.publicShareEnabled == true
        )
      ) || resource.data.isPublicShare == true || resource.data.publicShareEnabled == true;

      // Creation: Internal users, or authenticated agents/buyers creating their own quote without internal commercial fields
      allow create: if canAccessCMSOperations() || (
        (canAccessB2BQuotes() || isAuthenticated()) && (
          request.resource.data.agentId == request.auth.uid ||
          request.resource.data.userId == request.auth.uid ||
          request.resource.data.buyerId == request.auth.uid
        ) && (
          !('internalNettCost' in request.resource.data) &&
          !('supplierCost' in request.resource.data) &&
          !('internalMarkup' in request.resource.data) &&
          !('internalProfit' in request.resource.data)
        )
      );

      // Update: Internal users, or owner without tampering with internal commercial fields
      allow update: if canAccessCMSOperations() || (
        isAuthenticated() && (
          resource.data.agentId == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          resource.data.buyerId == request.auth.uid
        ) && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'internalNettCost',
            'supplierCost',
            'internalMarkup',
            'internalProfit',
            'dmcMarginAmount'
          ])
        )
      );

      // Deletion: Internal users or quotation owner
      allow delete: if canAccessCMSOperations() || (
        isAuthenticated() && (
          resource.data.agentId == request.auth.uid ||
          resource.data.userId == request.auth.uid
        )
      );

      // Split-document version manifests subcollection (created exclusively via explicit Save Draft)
      // Committed manifests are strictly immutable; only PREPARING -> COMMITTED|FAILED transitions are allowed.
      match /versions/{versionId} {
        allow get: if isValidId(quotationId) && isValidId(versionId) && (
          canAccessCMSOperations() || (
            isAuthenticated() && (
              resource.data.agentId == request.auth.uid ||
              resource.data.userId == request.auth.uid ||
              (
                exists(/databases/$(database)/documents/quotations/$(quotationId)) && (
                  get(/databases/$(database)/documents/quotations/$(quotationId)).data.agentId == request.auth.uid ||
                  get(/databases/$(database)/documents/quotations/$(quotationId)).data.userId == request.auth.uid
                )
              )
            )
          )
        );
        allow list: if isValidId(quotationId) && (
          canAccessCMSOperations() || (
            isAuthenticated() && (
              resource.data.agentId == request.auth.uid ||
              resource.data.userId == request.auth.uid ||
              (
                exists(/databases/$(database)/documents/quotations/$(quotationId)) && (
                  get(/databases/$(database)/documents/quotations/$(quotationId)).data.agentId == request.auth.uid ||
                  get(/databases/$(database)/documents/quotations/$(quotationId)).data.userId == request.auth.uid
                )
              )
            )
          )
        );
        allow create: if isValidId(quotationId) && isValidId(versionId) && (
          request.resource.data.quoteId == quotationId &&
          (request.resource.data.version is int || request.resource.data.version is number) &&
          request.resource.data.version >= 1 &&
          (
            !('manifestStatus' in request.resource.data) ||
            request.resource.data.manifestStatus in ['PREPARING', 'COMMITTED']
          )
        ) && (
          canAccessCMSOperations() || (
            isAuthenticated() && (
              request.resource.data.agentId == request.auth.uid ||
              request.resource.data.userId == request.auth.uid
            ) && (
              !('internalNettCost' in request.resource.data) &&
              !('supplierCost' in request.resource.data) &&
              !('internalMarkup' in request.resource.data) &&
              !('internalProfit' in request.resource.data) &&
              !('dmcMarginAmount' in request.resource.data) &&
              !('totalNetCost' in request.resource.data) &&
              !('totalMargin' in request.resource.data) &&
              !('marginAmount' in request.resource.data)
            )
          )
        );
        allow update: if isValidId(quotationId) && isValidId(versionId) && (
          (
            resource.data.manifestStatus == 'PREPARING' &&
            request.resource.data.manifestStatus in ['COMMITTED', 'FAILED'] &&
            request.resource.data.quoteId == resource.data.quoteId &&
            request.resource.data.version == resource.data.version &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'storageFormat',
              'schemaVersion',
              'manifestStatus',
              'committedAt',
              'sectionIds',
              'sectionRefs',
              'sections',
              'sectionCount',
              'chunkCount',
              'sectionsIntegrityHash',
              'totalReconstructedBytes',
              'failureReason',
              'isLatest',
              'isImmutable',
              'updatedAt',
              'migrationStatus',
              'migrationState',
              'migratedAt',
              'verifiedAt',
              'failingFieldPaths'
            ])
          ) ||
          (
            (!('storageFormat' in resource.data) || resource.data.storageFormat == 'SINGLE_DOC_V1') &&
            request.resource.data.storageFormat == 'SPLIT_SECTIONS_V2' &&
            request.resource.data.manifestStatus == 'COMMITTED' &&
            request.resource.data.quoteId == resource.data.quoteId &&
            request.resource.data.version == resource.data.version &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'storageFormat',
              'schemaVersion',
              'manifestStatus',
              'committedAt',
              'sectionIds',
              'sectionRefs',
              'sections',
              'sectionCount',
              'chunkCount',
              'sectionsIntegrityHash',
              'totalReconstructedBytes',
              'isLatest',
              'isImmutable',
              'updatedAt',
              'migrationStatus',
              'migrationState',
              'migratedAt',
              'verifiedAt',
              'totalItems',
              'totalHubs'
            ])
          )
        ) && (
          canAccessCMSOperations() || (
            isAuthenticated() && (
              resource.data.agentId == request.auth.uid ||
              resource.data.userId == request.auth.uid
            ) && (
              !('internalNettCost' in request.resource.data) &&
              !('supplierCost' in request.resource.data) &&
              !('internalMarkup' in request.resource.data) &&
              !('internalProfit' in request.resource.data) &&
              !('dmcMarginAmount' in request.resource.data) &&
              !('totalNetCost' in request.resource.data) &&
              !('totalMargin' in request.resource.data) &&
              !('marginAmount' in request.resource.data)
            )
          )
        );
        allow delete: if canAccessCMSOperations() || (
          isAuthenticated() &&
          resource.data.manifestStatus in ['PREPARING', 'FAILED'] &&
          (
            resource.data.agentId == request.auth.uid ||
            resource.data.userId == request.auth.uid
          )
        );

        // Modular section & dynamic chunk documents (write-once per version)
        match /sections/{sectionId} {
          allow get: if isValidId(quotationId) && isValidId(versionId) && isValidId(sectionId) && (
            canAccessCMSOperations() || (
              isAuthenticated() && (
                resource.data.agentId == request.auth.uid ||
                resource.data.userId == request.auth.uid ||
                (
                  exists(/databases/$(database)/documents/quotations/$(quotationId)) && (
                    get(/databases/$(database)/documents/quotations/$(quotationId)).data.agentId == request.auth.uid ||
                    get(/databases/$(database)/documents/quotations/$(quotationId)).data.userId == request.auth.uid
                  )
                )
              )
            )
          );
          allow list: if isValidId(quotationId) && isValidId(versionId) && (
            canAccessCMSOperations() || (
              isAuthenticated() && (
                resource.data.agentId == request.auth.uid ||
                resource.data.userId == request.auth.uid ||
                (
                  exists(/databases/$(database)/documents/quotations/$(quotationId)) && (
                    get(/databases/$(database)/documents/quotations/$(quotationId)).data.agentId == request.auth.uid ||
                    get(/databases/$(database)/documents/quotations/$(quotationId)).data.userId == request.auth.uid
                  )
                )
              )
            )
          );
          allow create: if isValidId(quotationId) && isValidId(versionId) && isValidId(sectionId) && (
            request.resource.data.quoteId == quotationId &&
            request.resource.data.versionId == versionId &&
            (request.resource.data.chunkIndex is int || request.resource.data.chunkIndex is number)
          ) && (
            canAccessCMSOperations() || (
              isAuthenticated() && (
                request.resource.data.agentId == request.auth.uid ||
                request.resource.data.userId == request.auth.uid
              ) && (
                !('internalNettCost' in request.resource.data) &&
                !('supplierCost' in request.resource.data) &&
                !('internalMarkup' in request.resource.data) &&
                !('internalProfit' in request.resource.data) &&
                !('dmcMarginAmount' in request.resource.data) &&
                !('totalNetCost' in request.resource.data) &&
                !('totalMargin' in request.resource.data) &&
                !('marginAmount' in request.resource.data) &&
                (
                  !('data' in request.resource.data) || (
                    !('internalNettCost' in request.resource.data.data) &&
                    !('supplierCost' in request.resource.data.data) &&
                    !('internalMarkup' in request.resource.data.data) &&
                    !('internalProfit' in request.resource.data.data) &&
                    !('totalNetCost' in request.resource.data.data) &&
                    !('totalMargin' in request.resource.data.data) &&
                    !('marginAmount' in request.resource.data.data)
                  )
                )
              )
            )
          );
          allow update: if isValidId(quotationId) && isValidId(versionId) && isValidId(sectionId) && (
            exists(/databases/$(database)/documents/quotations/$(quotationId)/versions/$(versionId)) &&
            get(/databases/$(database)/documents/quotations/$(quotationId)/versions/$(versionId)).data.manifestStatus in ['PREPARING', 'FAILED'] &&
            request.resource.data.quoteId == quotationId &&
            request.resource.data.versionId == versionId &&
            (request.resource.data.chunkIndex is int || request.resource.data.chunkIndex is number)
          ) && (
            canAccessCMSOperations() || (
              isAuthenticated() && (
                request.resource.data.agentId == request.auth.uid ||
                request.resource.data.userId == request.auth.uid
              ) && (
                !('internalNettCost' in request.resource.data) &&
                !('supplierCost' in request.resource.data) &&
                !('internalMarkup' in request.resource.data) &&
                !('internalProfit' in request.resource.data) &&
                !('dmcMarginAmount' in request.resource.data) &&
                !('totalNetCost' in request.resource.data) &&
                !('totalMargin' in request.resource.data) &&
                !('marginAmount' in request.resource.data) &&
                (
                  !('data' in request.resource.data) || (
                    !('internalNettCost' in request.resource.data.data) &&
                    !('supplierCost' in request.resource.data.data) &&
                    !('internalMarkup' in request.resource.data.data) &&
                    !('internalProfit' in request.resource.data.data) &&
                    !('totalNetCost' in request.resource.data.data) &&
                    !('totalMargin' in request.resource.data.data) &&
                    !('marginAmount' in request.resource.data.data)
                  )
                )
              )
            )
          );
          allow delete: if canAccessCMSOperations() || (
            isAuthenticated() &&
            exists(/databases/$(database)/documents/quotations/$(quotationId)/versions/$(versionId)) &&
            get(/databases/$(database)/documents/quotations/$(quotationId)/versions/$(versionId)).data.manifestStatus in ['PREPARING', 'FAILED'] &&
            (
              resource.data.agentId == request.auth.uid ||
              resource.data.userId == request.auth.uid
            )
          );
        }
      }
    }

    match /quote_versions/{versionId} {
      allow get: if isValidId(versionId) && (
        canAccessCMSOperations() || (
          isAuthenticated() && (
            resource.data.agentId == request.auth.uid ||
            resource.data.userId == request.auth.uid
          )
        )
      );
      allow list: if canAccessCMSOperations() || (
        isAuthenticated() && (
          resource.data.agentId == request.auth.uid ||
          resource.data.userId == request.auth.uid
        )
      );
      allow create: if isValidId(versionId) && (
        (request.resource.data.version is int || request.resource.data.version is number) &&
        request.resource.data.version >= 1
      ) && (
        canAccessCMSOperations() || (
          isAuthenticated() && (
            request.resource.data.agentId == request.auth.uid ||
            request.resource.data.userId == request.auth.uid
          ) && (
            !('internalNettCost' in request.resource.data) &&
            !('supplierCost' in request.resource.data) &&
            !('internalMarkup' in request.resource.data) &&
            !('internalProfit' in request.resource.data) &&
            !('dmcMarginAmount' in request.resource.data) &&
            !('totalNetCost' in request.resource.data) &&
            !('totalMargin' in request.resource.data) &&
            !('marginAmount' in request.resource.data)
          )
        )
      );
      allow update: if false;
      allow delete: if canAccessCMSOperations();
    }

    match /bookings/{bookingId} {
      // Internal users read all; B2B Agents read bookings they submitted OR bookings assigned to them
      allow read: if canAccessCMSOperations() || (
        isAuthenticated() && isNotBuyer() && (
          resource.data.submittedByUserId == request.auth.uid ||
          resource.data.submittingAgentId == request.auth.uid ||
          resource.data.assignedAgentId == request.auth.uid ||
          resource.data.agentId == request.auth.uid ||
          resource.data.userId == request.auth.uid
        )
      );

      // Create: Internal operations can create standard or INTERNAL_MANUAL bookings
      // External agents can only create bookings tagged to themselves with customer-facing prices only
      allow create: if canAccessCMSOperations() || (
        isAuthenticated() && isNotBuyer() && (
          request.resource.data.submittedByUserId == request.auth.uid ||
          request.resource.data.submittingAgentId == request.auth.uid ||
          request.resource.data.agentId == request.auth.uid ||
          request.resource.data.userId == request.auth.uid
        ) && (
          (!('sourceType' in request.resource.data) || request.resource.data.sourceType != 'INTERNAL_MANUAL') &&
          (!('isInternalManualBooking' in request.resource.data) || request.resource.data.isInternalManualBooking != true) &&
          !('totalSupplierCost' in request.resource.data) &&
          !('internalNettCost' in request.resource.data) &&
          !('internalProfit' in request.resource.data) &&
          !('supplierCost' in request.resource.data) &&
          !('originalTheUnboundMargin' in request.resource.data) &&
          !('remainingTheUnboundMargin' in request.resource.data) &&
          !('adminManualDiscountTotal' in request.resource.data) &&
          !('manualDiscountAdjustments' in request.resource.data) &&
          !('pricingSnapshotHistory' in request.resource.data)
        )
      );

      // Update: Internal operations can update all operational fields, supplier allocations, and pricing
      // External booking owner / assigned agent:
      // 1. Cannot touch any supplier or internal commercial fields under any circumstances
      // 2. Once booking is SUBMITTED or CONFIRMED, external agents CANNOT edit core booking details.
      //    They are restricted to managing passenger documentation (passports, PAN, visas).
      allow update: if canAccessCMSOperations() || (
        isAuthenticated() && isNotBuyer() && (
          resource.data.submittedByUserId == request.auth.uid ||
          resource.data.submittingAgentId == request.auth.uid ||
          resource.data.assignedAgentId == request.auth.uid ||
          resource.data.agentId == request.auth.uid
        ) && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'sourceType', 
            'isInternalManualBooking', 
            'totalSupplierCost', 
            'internalNettCost',
            'internalProfit',
            'supplierCost',
            'supplierAllocationStatus', 
            'operationalStatus',
            'supplierConfirmationOverride',
            'assignedAgentId',
            'assignedByUserId',
            'submittingAgentId',
            'commercialNettTotal',
            'commercialMargin',
            'assignedTeamMemberId',
            'assignedTeamMemberName',
            'assignedTeamMemberNameSnapshot',
            'assignedTeamMemberEmailSnapshot',
            'assignmentStatus',
            'assignmentHistory',
            'assignmentNotes',
            'agentId',
            'originalTheUnboundMargin',
            'remainingTheUnboundMargin',
            'adminManualDiscountTotal',
            'manualDiscountAdjustments',
            'pricingSnapshotHistory',
            'currentPricingSnapshotId',
            'currentPricingSnapshotVersion',
            'hasRevisedPricingAfterInvoice',
            'revisedPricingNotice',
            'revisedPricingVersion',
            'agentNameSnapshot',
            'agentEmailSnapshot',
            'agentAgencySnapshot',
            'agentVisibilityStatus',
            'lastReassignedAt',
            'lastReassignedByUserId',
            'lastReassignedByUserNameSnapshot'
          ]) && (
            !(
              resource.data.status in ['SUBMITTED', 'CONFIRMED', 'PROCESSING', 'IN_PROGRESS', 'COMPLETED', 'CANCELLED'] ||
              ('isSubmitted' in resource.data && resource.data.isSubmitted == true) ||
              ('submissionStatus' in resource.data && resource.data.submissionStatus == 'SUBMITTED')
            ) ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'passengers',
              'missingDocuments',
              'documentStatus',
              'timeline',
              'updatedAt',
              'updatedBy',
              'updatedByRole',
              'updatedByEmail',
              'isDeleted',
              'customerFacingNotes'
            ]) && (
              !('isDeleted' in request.resource.data) ||
              request.resource.data.isDeleted == resource.data.isDeleted
            )
          )
        )
      );

      // Deletion: STRICTLY RESERVED for Authorized Internal Operations
      allow delete: if canAccessCMSOperations() || isValidAdminCMSData() || isResourceAdminOwned();

      // Subcollection: Booking activity log and operational timeline
      match /operations_history/{historyId} {
        allow read, write: if canAccessCMSOperations();
      }
    }

    // =========================================================================
    // PASSENGER COMPLIANCE DOCUMENTS METADATA (Firebase Storage + Firestore)
    // Actual binary files reside in Firebase Storage (`bookings/{bookingId}/...`).
    // Strictly scoped to Booking ID + Passenger ID; zero public/Buyer access.
    // =========================================================================

    function isValidBookingPassengerDocument(data, docId) {
      return isValidId(docId) &&
        data.id == docId &&
        data.bookingId is string && data.bookingId.size() > 0 && data.bookingId.size() <= 128 &&
        data.passengerId is string && data.passengerId.size() > 0 && data.passengerId.size() <= 128 &&
        data.category in [
          'PASSPORT_FRONT',
          'PASSPORT_BACK',
          'VISA_COPY',
          'PAN_CARD',
          'NATIONAL_ID',
          'TRAVEL_INSURANCE',
          'FLIGHT_TICKET',
          'MEDICAL_DECLARATION',
          'OTHER_COMPLIANCE'
        ] &&
        data.documentType is string && data.documentType.size() > 0 && data.documentType.size() <= 120 &&
        data.originalFileName is string && data.originalFileName.size() > 0 && data.originalFileName.size() <= 255 &&
        data.storagePath is string && data.storagePath.size() > 0 && data.storagePath.size() <= 512 &&
        data.storagePath.matches('^bookings/.*') &&
        data.mimeType in ['application/pdf', 'image/jpeg', 'image/png', 'image/webp'] &&
        (data.fileSizeBytes is int || data.fileSizeBytes is number) &&
        data.fileSizeBytes > 0 && data.fileSizeBytes <= 15728640 &&
        data.uploadedBy is string && data.uploadedBy.size() > 0 && data.uploadedBy.size() <= 128 &&
        data.uploadedAt is string && data.uploadedAt.size() > 0 && data.uploadedAt.size() <= 64 &&
        data.status in ['ACTIVE', 'REPLACED', 'DELETED'] &&
        (data.version is int || data.version is number) && data.version >= 1 &&
        (!('verificationStatus' in data) || data.verificationStatus in ['PENDING_REVIEW', 'APPROVED', 'VERIFIED', 'REJECTED']) &&
        (!('verificationNotes' in data) || (data.verificationNotes is string && data.verificationNotes.size() <= 2000)) &&
        (!('storageBackend' in data) || data.storageBackend in ['FIREBASE_STORAGE', 'FIRESTORE_CHUNKS']) &&
        (!('blobGroupId' in data) || (data.blobGroupId is string && data.blobGroupId.size() <= 160)) &&
        (!('chunkCount' in data) || ((data.chunkCount is int || data.chunkCount is number) && data.chunkCount >= 1 && data.chunkCount <= 40));
    }

    function isValidPassengerDocumentBlobChunk(data, chunkId) {
      return isValidId(chunkId) &&
        data != null &&
        data.keys().hasAll([
          'id', 'documentId', 'bookingId', 'passengerId', 'chunkIndex',
          'totalChunks', 'mimeType', 'dataBase64', 'uploadedBy', 'uploadedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'documentId', 'blobGroupId', 'bookingId', 'passengerId',
          'agentId', 'submittedByUserId', 'assignedAgentId', 'storagePath',
          'originalFileName', 'fileSizeBytes', 'chunkIndex', 'totalChunks',
          'mimeType', 'dataBase64', 'uploadedBy', 'uploadedAt'
        ]) &&
        data.id is string && data.id == chunkId &&
        data.documentId is string && data.documentId.size() > 0 && data.documentId.size() <= 128 &&
        (!('blobGroupId' in data) || (data.blobGroupId is string && data.blobGroupId.size() > 0 && data.blobGroupId.size() <= 160)) &&
        data.bookingId is string && data.bookingId.size() > 0 && data.bookingId.size() <= 128 &&
        data.passengerId is string && data.passengerId.size() > 0 && data.passengerId.size() <= 128 &&
        (data.chunkIndex is int || data.chunkIndex is number) && data.chunkIndex >= 0 && data.chunkIndex < 40 &&
        (data.totalChunks is int || data.totalChunks is number) && data.totalChunks >= 1 && data.totalChunks <= 40 &&
        data.mimeType in ['application/pdf', 'image/jpeg', 'image/png', 'image/webp'] &&
        data.dataBase64 is string && data.dataBase64.size() > 0 && data.dataBase64.size() <= 750000 &&
        data.uploadedBy is string && data.uploadedBy.size() > 0 && data.uploadedBy.size() <= 128 &&
        data.uploadedAt is string && data.uploadedAt.size() > 0 && data.uploadedAt.size() <= 64 &&
        (!('storagePath' in data) || (data.storagePath is string && data.storagePath.size() <= 512)) &&
        (!('originalFileName' in data) || (data.originalFileName is string && data.originalFileName.size() <= 255)) &&
        (!('fileSizeBytes' in data) || ((data.fileSizeBytes is int || data.fileSizeBytes is number) && data.fileSizeBytes > 0 && data.fileSizeBytes <= 15728640));
    }

    match /booking_passenger_documents/{docId} {
      allow get: if isValidId(docId) && (
        canAccessCMSOperations() ||
        canAccessCMSFinance() ||
        (isAuthenticated() && isNotBuyer() && (
          resource.data.agentId == request.auth.uid ||
          resource.data.submittedByUserId == request.auth.uid ||
          resource.data.assignedAgentId == request.auth.uid ||
          resource.data.uploadedBy == request.auth.uid
        ))
      );

      allow list: if canAccessCMSOperations() ||
        canAccessCMSFinance() ||
        (isAuthenticated() && isNotBuyer() && (
          resource.data.agentId == request.auth.uid ||
          resource.data.submittedByUserId == request.auth.uid ||
          resource.data.assignedAgentId == request.auth.uid ||
          resource.data.uploadedBy == request.auth.uid
        ));

      allow create: if isValidBookingPassengerDocument(request.resource.data, docId) && (
        canAccessCMSOperations() ||
        canAccessCMSFinance() ||
        (isAuthenticated() && isNotBuyer() &&
          request.resource.data.uploadedBy == request.auth.uid && (
            request.resource.data.agentId == request.auth.uid ||
            request.resource.data.submittedByUserId == request.auth.uid ||
            request.resource.data.assignedAgentId == request.auth.uid
          )
        )
      );

      allow update: if isValidBookingPassengerDocument(request.resource.data, docId) &&
        request.resource.data.bookingId == resource.data.bookingId &&
        request.resource.data.passengerId == resource.data.passengerId && (
          canAccessCMSOperations() ||
          canAccessCMSFinance() ||
          (isAuthenticated() && isNotBuyer() && (
            resource.data.agentId == request.auth.uid ||
            resource.data.submittedByUserId == request.auth.uid ||
            resource.data.assignedAgentId == request.auth.uid
          ) && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'bookingId',
            'passengerId',
            'agentId',
            'submittedByUserId',
            'assignedAgentId',
            'verificationStatus',
            'verifiedBy',
            'verifiedByName',
            'verifiedAt'
          ]))
        );

      // Soft-delete preserves compliance audit trail; hard-delete strictly Admin/Operations only
      allow delete: if isValidId(docId) && (canAccessCMSOperations() || isMasterAdmin());
    }

    match /booking_passenger_document_blobs/{chunkId} {
      allow get: if isValidId(chunkId) && (
        canAccessCMSOperations() ||
        canAccessCMSFinance() ||
        (isAuthenticated() && isNotBuyer() && (
          resource.data.agentId == request.auth.uid ||
          resource.data.submittedByUserId == request.auth.uid ||
          resource.data.assignedAgentId == request.auth.uid ||
          resource.data.uploadedBy == request.auth.uid
        ))
      );

      allow list: if canAccessCMSOperations() ||
        canAccessCMSFinance() ||
        (isAuthenticated() && isNotBuyer() && (
          resource.data.agentId == request.auth.uid ||
          resource.data.submittedByUserId == request.auth.uid ||
          resource.data.assignedAgentId == request.auth.uid ||
          resource.data.uploadedBy == request.auth.uid
        ));

      allow create: if isValidPassengerDocumentBlobChunk(request.resource.data, chunkId) && (
        canAccessCMSOperations() ||
        canAccessCMSFinance() ||
        (isAuthenticated() && isNotBuyer() &&
          request.resource.data.uploadedBy == request.auth.uid && (
            request.resource.data.agentId == request.auth.uid ||
            request.resource.data.submittedByUserId == request.auth.uid ||
            request.resource.data.assignedAgentId == request.auth.uid
          )
        )
      );

      allow update: if false;
      allow delete: if isValidId(chunkId) && (canAccessCMSOperations() || isMasterAdmin());
    }

    match /agent_notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.agentUserId == request.auth.uid ||
        canAccessCMSOperations()
      );
      allow create, update: if isAuthenticated();
      allow delete: if canAccessCMSOperations();
    }

    // =========================================================================
    // B2B AGENT CLIENTS & TASKS ISOLATION
    // Agents manage their own customers and tasks; Internal staff can view/assist
    // =========================================================================

    match /b2b_customers/{id} {
      allow read: if canAccessCMSOperations() || (
        isAuthenticated() && resource.data.agentId == request.auth.uid
      );
      allow write: if canAccessCMSOperations() || (
        isAuthenticated() && (
          request.resource.data.agentId == request.auth.uid ||
          resource.data.agentId == request.auth.uid
        )
      );
    }

    match /b2b_tasks/{id} {
      allow read, write: if canAccessCMSOperations() || (
        isAuthenticated() && (
          resource.data.agentId == request.auth.uid ||
          request.resource.data.agentId == request.auth.uid
        )
      );
    }

    match /tasks/{id} {
      allow read, write: if canAccessCMSOperations() || (
        isAuthenticated() && (
          resource.data.agentId == request.auth.uid ||
          request.resource.data.agentId == request.auth.uid
        )
      );
    }

    // =========================================================================
    // OPERATIONAL ROSTER & INTERNAL WORKFLOWS
    // =========================================================================

    match /calendar_tasks/{id} {
      // 1. Read: Internal staff with tasksView permission, assigned assignee, or creator
      allow read: if canManageCalendarTasks() || (
        isAuthenticated() && (
          resource.data.assignedTo == request.auth.uid ||
          resource.data.assignedToEmail == request.auth.token.email ||
          resource.data.createdBy == request.auth.uid
        )
      ) || !isAuthenticated();

      // 2. Create: Internal staff with tasksCreate permission or system automation
      allow create: if canCreateCalendarTasks() || !isAuthenticated();

      // 3. Update: Internal staff with tasksEdit permission, or task assignee completing task
      allow update: if canEditCalendarTasks() || (
        canCompleteCalendarTasks() && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt', 'completedBy', 'updatedAt', 'auditMetadata'])
        )
      ) || (
        isAuthenticated() && (
          resource.data.assignedTo == request.auth.uid ||
          resource.data.assignedToEmail == request.auth.token.email
        ) && canCompleteCalendarTasks()
      ) || !isAuthenticated();

      // 4. Delete: Administrators or users with explicit tasksDelete permission
      allow delete: if canDeleteCalendarTasks() || !isAuthenticated();
    }

    match /job_sheets/{id} {
      allow read, write: if canAccessCMSOperations();
    }

    match /roster_resources/{id} {
      allow read, write: if canAccessCMSOperations();
    }

    // =========================================================================
    // FINANCIALS & ACCOUNTING (Protected by cmsFinance permissions)
    // =========================================================================

    match /financial_invoices/{id} {
      allow read: if canAccessCMSFinance() || (
        isAuthenticated() && (
          resource.data.buyerId == request.auth.uid ||
          resource.data.agentId == request.auth.uid
        )
      );
      allow write: if canAccessCMSFinance();
    }

    match /invoices/{id} {
      allow read: if canAccessCMSFinance() || canAccessCMSOperations() || (
        isAuthenticated() && isNotBuyer() && (
          resource.data.buyerId == request.auth.uid ||
          resource.data.agentId == request.auth.uid ||
          resource.data.responsibleAgentId == request.auth.uid
        )
      );
      allow create, update: if isValidId(id) && (canAccessCMSFinance() || canAccessCMSOperations());
      allow delete: if isValidId(id) && (canAccessCMSFinance() || isMasterAdmin());
    }

    match /financial_vouchers/{id} {
      allow read: if canAccessCMSFinance() || canAccessCMSOperations() || (
        isAuthenticated() && (
          resource.data.buyerId == request.auth.uid ||
          resource.data.agentId == request.auth.uid
        )
      );
      allow write: if canAccessCMSFinance() || canAccessCMSOperations();
    }

    match /vouchers/{id} {
      allow read: if canAccessCMSFinance() || canAccessCMSOperations() || (
        isAuthenticated() && (
          resource.data.buyerId == request.auth.uid ||
          resource.data.agentId == request.auth.uid
        )
      );
      allow write: if canAccessCMSFinance() || canAccessCMSOperations();
    }

    match /uploaded_invoices/{id} {
      // Strictly internal operational & financial access - never exposed to buyers or agents
      allow read, write: if canAccessCMSFinance() || canAccessCMSOperations() || isMasterAdmin();
    }

    match /financial_ledgers/{id} {
      allow read, write: if canAccessCMSFinance();
    }

    // =========================================================================
    // CENTRALIZED SURCHARGE MANAGEMENT (Finance & Administration)
    // Writes & audit history strictly restricted to Master Admin / Finance.
    // B2B Quote Builder reads active surcharge catalogs; Buyers/Agents cannot mutate.
    // =========================================================================

    match /surcharge_masters/{surchargeId} {
      allow read: if true;
      allow create, update: if isMasterAdmin() || canAccessCMSFinance() || isValidAdminCMSData();
      allow delete: if isMasterAdmin() || canAccessCMSFinance() || isResourceAdminOwned();
    }

    match /surcharge_product_mappings/{mappingId} {
      allow read: if true;
      allow create, update: if isMasterAdmin() || canAccessCMSFinance() || isValidAdminCMSData();
      allow delete: if isMasterAdmin() || canAccessCMSFinance() || isResourceAdminOwned();
    }

    match /surcharge_history/{historyId} {
      allow read: if isMasterAdmin() || canAccessCMSFinance() || isInternalUser();
      allow create: if isMasterAdmin() || canAccessCMSFinance() || isValidAdminCMSData();
      allow update, delete: if false;
    }

    // =========================================================================
    // SYSTEM AUDITING, TELEMETRY & DIAGNOSTICS
    // =========================================================================

    match /audit_logs/{id} {
      allow read: if true;
      allow create: if true; // Append-only audit record creation
      allow update, delete: if isMasterAdmin(); // Immutable audit trail
    }

    match /admin_activities/{id} {
      allow read, write: if true;
    }

    match /user_activities/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isMasterAdmin();
    }

    match /journey_events/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isMasterAdmin();
    }

    match /system_events/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isMasterAdmin();
    }

    match /ai_planner_sessions/{id} {
      allow read, write: if true;
    }

    match /chat_sessions/{document=**} {
      allow read, write: if true;
    }

    match /sla_automation_rules/{id} {
      allow read, write: if true;
    }

    match /sla_automation_audit_logs/{id} {
      allow read, write: if true;
    }

    match /email_logs/{id} {
      allow read, write: if canAccessCMSSystem();
    }

    match /theunbound_communication_audit_logs/{id} {
      allow read: if canAccessCMSSystem();
      allow create: if true;
      allow update, delete: if isMasterAdmin();
    }

    match /sheets_sync_history/{id} {
      allow read, write: if canAccessCMSSystem();
    }

    function isValidGlobalDisplayCurrency(data) {
      return data != null
        && data.keys().hasAll(['displayCurrency', 'updatedAt', 'updatedBy'])
        && data.displayCurrency is string
        && data.displayCurrency in ['USD', 'EUR', 'GBP', 'JPY', 'AED', 'THB', 'AUD', 'CAD', 'SGD', 'INR', 'CHF']
        && data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 64
        && data.updatedBy is string && data.updatedBy.size() > 0 && data.updatedBy.size() <= 128
        && (!('updatedByEmail' in data) || (data.updatedByEmail is string && data.updatedByEmail.size() <= 160))
        && (!('updatedByName' in data) || (data.updatedByName is string && data.updatedByName.size() <= 160))
        && (!('updatedByRole' in data) || data.updatedByRole in ['ADMIN', 'SUPER_ADMIN'])
        && (!('fxSource' in data) || (data.fxSource is string && data.fxSource.size() <= 120));
    }

    match /systemSettings/globalDisplayCurrency {
      allow read: if true;
      allow create, update: if isMasterAdmin() && isValidGlobalDisplayCurrency(request.resource.data);
      allow delete: if false;
    }

    match /system_settings/{document=**} {
      allow read: if true;
      allow write: if canAccessCMSSystem();
    }

    match /notifications/{id} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        resource.data.agentId == request.auth.uid ||
        canAccessCMSOperations()
      );
      allow write: if isAuthenticated();
    }

    match /test/{id} {
      allow read, write: if isMasterAdmin();
    }

    // =========================================================================
    // SEO INFRASTRUCTURE & REDIRECTS
    // =========================================================================

    match /seo_redirects/{id} {
      allow read: if true;
      allow write: if canAccessCMSContent();
    }

    match /seo_settings/{id} {
      allow read: if true;
      allow write: if canAccessCMSContent();
    }

    // =========================================================================
    // SUPPLIER MANAGEMENT MASTER DIRECTORY & ALLOCATIONS
    // Strictly Internal-Only: Admin & Authorized Internal Team Members
    // External Buyers & B2B Agents have strictly NO access.
    // =========================================================================

    match /suppliers/{supplierId} {
      allow read: if isInternalUser();
      allow create, update: if isInternalUser();
      allow delete: if isMasterAdmin();
    }

    match /supplier_rate_cards/{id} {
      allow read: if isInternalUser();
      allow create, update: if isInternalUser();
      allow delete: if isMasterAdmin();
    }

    match /supplier_documents/{id} {
      allow read: if isInternalUser();
      allow create, update: if isInternalUser();
      allow delete: if isMasterAdmin();
    }

    match /supplier_activity_history/{id} {
      allow read: if isInternalUser();
      allow create: if isInternalUser();
      allow update, delete: if isMasterAdmin();
    }

    match /supplier_allocations/{id} {
      allow read: if isInternalUser();
      allow create, update: if isInternalUser();
      allow delete: if isMasterAdmin();
    }

    match /supplier_price_records/{id} {
      allow read: if isInternalUser();
      allow create: if isInternalUser();
      allow update, delete: if isMasterAdmin();
    }

    match /supplier_requests/{id} {
      allow read, write: if isInternalUser();
    }

    // =========================================================================
    // USER PERSONAL STORAGE (Wishlists)
    // =========================================================================

    match /wishlist_folders/{id} {
      allow read, write: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
    }

    match /wishlist_items/{id} {
      allow read, write: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
    }

    // =========================================================================
    // MARGIN & COMMISSION GOVERNANCE (Strictly Admin / Finance Admin Only)
    // B2B Agents, Buyers, and unprivileged Staff have strictly NO read/write access.
    // =========================================================================

    function isValidProductMarginConfig(data) {
      return data != null &&
        data.keys().hasAll([
          'id', 'productId', 'marginType', 'marginValue', 'b2bAgentMarkupPercent',
          'defaultMarkupPercent', 'commissionPercent', 'isActive', 'status',
          'version', 'updatedAt', 'updatedByUid', 'updatedByEmail', 'updatedByRole'
        ]) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.productId is string && data.productId == data.id &&
        data.marginType in ['PERCENTAGE', 'FIXED'] &&
        (data.marginValue is int || data.marginValue is float) && data.marginValue >= 0 &&
        (data.b2bAgentMarkupPercent is int || data.b2bAgentMarkupPercent is float) && data.b2bAgentMarkupPercent >= 0 &&
        (data.defaultMarkupPercent is int || data.defaultMarkupPercent is float) && data.defaultMarkupPercent >= 0 &&
        (data.commissionPercent is int || data.commissionPercent is float) && data.commissionPercent >= 0 && data.commissionPercent <= 100 &&
        data.isActive is bool &&
        data.status in ['ACTIVE', 'INACTIVE'] &&
        (data.version is int || data.version is float) && data.version >= 1 &&
        data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 64 &&
        data.updatedByUid is string && data.updatedByUid.size() > 0 && data.updatedByUid.size() <= 128 &&
        data.updatedByEmail is string && data.updatedByEmail.size() > 0 && data.updatedByEmail.size() <= 200 &&
        data.updatedByRole in ['ADMIN', 'SUPER_ADMIN', 'TEAM_MEMBER', 'DMC_STAFF'];
    }

    function isValidProductMarginAuditLog(data) {
      return data != null &&
        data.keys().hasAll([
          'id', 'productId', 'action', 'newMarginType', 'newMarginValue',
          'newCommissionPercent', 'newStatus', 'previousVersion', 'newVersion',
          'actorUid', 'actorEmail', 'actorRole', 'timestamp'
        ]) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 160 &&
        data.productId is string && data.productId.size() > 0 && data.productId.size() <= 128 &&
        data.action in ['MARGIN_CREATED', 'MARGIN_UPDATED', 'MARGIN_BULK_UPDATED', 'COMMISSION_UPDATED', 'MARGIN_STATUS_CHANGED'] &&
        data.newMarginType in ['PERCENTAGE', 'FIXED'] &&
        (data.newMarginValue is int || data.newMarginValue is float) && data.newMarginValue >= 0 &&
        (data.newCommissionPercent is int || data.newCommissionPercent is float) && data.newCommissionPercent >= 0 && data.newCommissionPercent <= 100 &&
        data.newStatus in ['ACTIVE', 'INACTIVE'] &&
        (data.previousVersion is int || data.previousVersion is float) && data.previousVersion >= 0 &&
        (data.newVersion is int || data.newVersion is float) && data.newVersion >= 1 &&
        data.actorUid is string && data.actorUid.size() > 0 && data.actorUid.size() <= 128 &&
        data.actorEmail is string && data.actorEmail.size() > 0 && data.actorEmail.size() <= 200 &&
        data.actorRole in ['ADMIN', 'SUPER_ADMIN', 'TEAM_MEMBER', 'DMC_STAFF'] &&
        data.timestamp is string && data.timestamp.size() > 0 && data.timestamp.size() <= 64;
    }

    match /product_margin_configs/{productId} {
      allow read: if isAuthenticated() && canAccessCMSFinance();
      allow create: if isAuthenticated() && isValidId(productId) && canAccessCMSFinance() && isValidProductMarginConfig(request.resource.data);
      allow update: if isAuthenticated() && isValidId(productId) && canAccessCMSFinance() &&
        isValidProductMarginConfig(request.resource.data) &&
        request.resource.data.productId == resource.data.productId &&
        request.resource.data.version >= resource.data.version;
      allow delete: if isMasterAdmin();
    }

    match /product_margin_audit_logs/{logId} {
      allow read: if isAuthenticated() && canAccessCMSFinance();
      allow create: if isAuthenticated() && isValidId(logId) && canAccessCMSFinance() && isValidProductMarginAuditLog(request.resource.data);
      allow update, delete: if isMasterAdmin();
    }

    // =========================================================================
    // CASHBACK & REWARDS WALLET (RBAC + Owner Isolation + Anti-Self-Approval)
    // =========================================================================

    function isValidCashbackUserConfig(data) {
      return data != null &&
        data.keys().hasAll(['userId', 'isEligible', 'cashbackPercent', 'status', 'updatedAt', 'updatedByUid']) &&
        data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
        data.isEligible is bool &&
        (data.cashbackPercent is int || data.cashbackPercent is float) &&
        data.cashbackPercent >= 0 && data.cashbackPercent <= 100 &&
        data.status in ['ACTIVE', 'INACTIVE', 'SUSPENDED'] &&
        data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 64 &&
        data.updatedByUid is string && data.updatedByUid.size() > 0 && data.updatedByUid.size() <= 128;
    }

    function isValidUserBankAccount(data, expectedUid) {
      return data != null &&
        data.keys().hasAll([
          'id', 'userId', 'accountHolderName', 'bankName',
          'accountNumberMasked', 'accountNumberLast4', 'country', 'currency', 'isDefault', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.userId is string && data.userId == expectedUid &&
        data.accountHolderName is string && data.accountHolderName.size() >= 2 && data.accountHolderName.size() <= 150 &&
        data.bankName is string && data.bankName.size() >= 2 && data.bankName.size() <= 150 &&
        data.accountNumberMasked is string && data.accountNumberMasked.size() >= 4 && data.accountNumberMasked.size() <= 32 &&
        data.accountNumberLast4 is string && data.accountNumberLast4.size() == 4 &&
        data.country is string && data.country.size() >= 2 && data.country.size() <= 100 &&
        data.currency is string && data.currency.size() == 3 &&
        data.isDefault is bool &&
        (!('ifscCode' in data) || data.ifscCode == null || data.ifscCode == '' || data.ifscCode.matches('^[A-Z]{4}0[A-Z0-9]{6}$'));
    }

    function isValidWithdrawalCreate(data, expectedUid) {
      return data != null &&
        data.keys().hasAll([
          'id', 'userId', 'requestedAmount', 'currency', 'bankAccountId',
          'bankSnapshotMasked', 'status', 'submittedAt'
        ]) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.userId is string && data.userId == expectedUid &&
        (data.requestedAmount is int || data.requestedAmount is float) && data.requestedAmount > 0 &&
        data.currency is string && data.currency.size() == 3 &&
        data.bankAccountId is string && data.bankAccountId.size() > 0 && data.bankAccountId.size() <= 128 &&
        data.status == 'SUBMITTED' &&
        data.submittedAt is string && data.submittedAt.size() > 0 && data.submittedAt.size() <= 64;
    }

    match /cashback_user_configs/{uid} {
      allow get: if isAuthenticated() && isValidId(uid) && (request.auth.uid == uid || canAccessCMSFinance());
      allow list: if isAuthenticated() && (canAccessCMSFinance() || resource.data.userId == request.auth.uid);
      allow create, update: if isAuthenticated() && isValidId(uid) && canAccessCMSFinance() &&
        isValidCashbackUserConfig(request.resource.data) && request.resource.data.userId == uid;
      allow delete: if false;
    }

    match /cashback_config_history/{historyId} {
      allow read: if isAuthenticated() && (canAccessCMSFinance() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && isValidId(historyId) && canAccessCMSFinance();
      allow update, delete: if false;
    }

    match /cashback_wallets/{uid} {
      allow get: if isAuthenticated() && isValidId(uid) && (request.auth.uid == uid || canAccessCMSFinance());
      allow list: if isAuthenticated() && (canAccessCMSFinance() || resource.data.userId == request.auth.uid);
      allow create, update: if isAuthenticated() && isValidId(uid) && (canAccessCMSFinance() || request.auth.uid == uid) &&
        request.resource.data.userId == uid &&
        (request.resource.data.availableBalance is int || request.resource.data.availableBalance is float) &&
        request.resource.data.availableBalance >= 0;
      allow delete: if false;
    }

    match /cashback_ledger_transactions/{txId} {
      allow read: if isAuthenticated() && (canAccessCMSFinance() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && isValidId(txId) && (
        canAccessCMSFinance() ||
        (request.resource.data.userId == request.auth.uid && request.resource.data.type in ['WITHDRAWAL_HOLD', 'WITHDRAWAL_RELEASE'])
      ) && (request.resource.data.amount is int || request.resource.data.amount is float) && request.resource.data.amount > 0;
      allow update, delete: if false;
    }

    match /booking_cashback_records/{recordId} {
      allow read: if isAuthenticated() && (canAccessCMSFinance() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && isValidId(recordId) && (
        canAccessCMSFinance() ||
        request.resource.data.userId == request.auth.uid
      );
      allow update: if isAuthenticated() && isValidId(recordId) && canAccessCMSFinance();
      allow delete: if false;
    }

    match /user_bank_accounts/{accountId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || canAccessCMSFinance());
      allow create: if isAuthenticated() && isValidId(accountId) && isValidUserBankAccount(request.resource.data, request.auth.uid);
      allow update: if isAuthenticated() && isValidId(accountId) &&
        resource.data.userId == request.auth.uid &&
        isValidUserBankAccount(request.resource.data, request.auth.uid);
      allow delete: if isAuthenticated() && isValidId(accountId) && resource.data.userId == request.auth.uid;
    }

    match /cashbackWithdrawalRequests/{requestId} {
      allow read: if isAuthenticated() && (canAccessCMSFinance() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && isValidId(requestId) && isValidWithdrawalCreate(request.resource.data, request.auth.uid);
      allow update: if isAuthenticated() && isValidId(requestId) && (
        (
          request.auth.uid == resource.data.userId &&
          resource.data.status == 'SUBMITTED' &&
          request.resource.data.status == 'CANCELLED' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'releaseLedgerTransactionId', 'statusHistory', 'updatedAt'])
        ) ||
        (
          canAccessCMSFinance() &&
          request.auth.uid != resource.data.userId &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.requestedAmount == resource.data.requestedAmount &&
          request.resource.data.status in ['UNDER_REVIEW', 'APPROVED', 'PROCESSING', 'PAID', 'REJECTED']
        )
      );
      allow delete: if false;
    }

    match /cashback_audit_logs/{logId} {
      allow read: if isAuthenticated() && canAccessCMSFinance();
      allow create: if isAuthenticated() && isValidId(logId) && (canAccessCMSFinance() || request.resource.data.actorUid == request.auth.uid);
      allow update, delete: if false;
    }

    match /cashback_notifications/{notifId} {
      allow read: if isAuthenticated() && (canAccessCMSFinance() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && isValidId(notifId) && (canAccessCMSFinance() || request.resource.data.userId == request.auth.uid);
      allow update: if isAuthenticated() && isValidId(notifId) && resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if false;
    }

    // Nested user & booking subcollections aligned with strict ownership & RBAC
    match /users/{userId}/cashback/{docId} {
      allow read: if isAuthenticated() && isValidId(userId) && (request.auth.uid == userId || canAccessCMSFinance());
      allow write: if isAuthenticated() && isValidId(userId) && canAccessCMSFinance();
    }

    match /users/{userId}/cashback/transactions/items/{txId} {
      allow read: if isAuthenticated() && isValidId(userId) && (request.auth.uid == userId || canAccessCMSFinance());
      allow create: if isAuthenticated() && isValidId(userId) && isValidId(txId) && (canAccessCMSFinance() || request.auth.uid == userId);
      allow update, delete: if false;
    }

    match /users/{userId}/bankAccounts/{accountId} {
      allow read: if isAuthenticated() && isValidId(userId) && (request.auth.uid == userId || canAccessCMSFinance());
      allow create, update: if isAuthenticated() && isValidId(userId) && isValidId(accountId) &&
        request.auth.uid == userId && isValidUserBankAccount(request.resource.data, userId);
      allow delete: if isAuthenticated() && isValidId(userId) && isValidId(accountId) && request.auth.uid == userId;
    }

    match /bookings/{bookingId}/cashback/{recordId} {
      allow read: if isAuthenticated() && (canAccessCMSFinance() || resource.data.userId == request.auth.uid);
      allow write: if isAuthenticated() && canAccessCMSFinance();
    }

    // Quote Builder traceable durable operation state tracking (no raw itinerary blobs or internal costs)
    match /quotation_operations/{operationId} {
      allow read: if isAuthenticated() && isValidId(operationId) && (
        canAccessCMSOperations() || resource.data.uid == request.auth.uid
      );
      allow create, update: if isAuthenticated() && isValidId(operationId) && (
        request.resource.data.operationId == operationId &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.quoteId is string && request.resource.data.quoteId.size() > 0 && request.resource.data.quoteId.size() <= 128 &&
        request.resource.data.idempotencyKey is string && request.resource.data.idempotencyKey.size() > 0 && request.resource.data.idempotencyKey.size() <= 200 &&
        request.resource.data.operationType in ['SAVE_DRAFT', 'SNAPSHOT_CREATE', 'PDF_GENERATE', 'EMAIL_SEND', 'WHATSAPP_SHARE', 'SAVE_MASTER_PACKAGE', 'CONVERT_BOOKING'] &&
        request.resource.data.status in ['IDLE', 'PREPARING', 'IN_PROGRESS', 'VERIFYING', 'SUCCEEDED', 'FAILED', 'TIMED_OUT', 'RETRY_AVAILABLE'] &&
        !('internalNettCost' in request.resource.data) &&
        !('supplierCost' in request.resource.data) &&
        !('totalNetCost' in request.resource.data)
      );
      allow delete: if false;
    }

    // =========================================================================
    // WEBSITE CONTENT: ABOUT US & MEET OUR TEAM DYNAMIC GALLERY
    // =========================================================================

    function isValidAboutUsWebsiteContent(data) {
      return data != null &&
        data.keys().hasAll(['pageId', 'meetOurTeamConfig', 'updatedAt']) &&
        data.keys().hasOnly(['pageId', 'meetOurTeamConfig', 'updatedAt', 'updatedBy', 'updatedByRole', 'updatedByEmail']) &&
        data.pageId == 'aboutUs' &&
        data.meetOurTeamConfig is map &&
        'heading' in data.meetOurTeamConfig &&
        data.meetOurTeamConfig.heading is string &&
        data.meetOurTeamConfig.heading.size() >= 2 &&
        data.meetOurTeamConfig.heading.size() <= 140 &&
        (!('introText' in data.meetOurTeamConfig) || (data.meetOurTeamConfig.introText is string && data.meetOurTeamConfig.introText.size() <= 1000)) &&
        (!('desktopColumns' in data.meetOurTeamConfig) || (data.meetOurTeamConfig.desktopColumns is int && data.meetOurTeamConfig.desktopColumns >= 1 && data.meetOurTeamConfig.desktopColumns <= 6)) &&
        (!('tabletColumns' in data.meetOurTeamConfig) || (data.meetOurTeamConfig.tabletColumns is int && data.meetOurTeamConfig.tabletColumns >= 1 && data.meetOurTeamConfig.tabletColumns <= 4)) &&
        (!('mobileColumns' in data.meetOurTeamConfig) || (data.meetOurTeamConfig.mobileColumns is int && data.meetOurTeamConfig.mobileColumns >= 1 && data.meetOurTeamConfig.mobileColumns <= 2)) &&
        (!('rows' in data.meetOurTeamConfig) || (data.meetOurTeamConfig.rows is int && data.meetOurTeamConfig.rows >= 1 && data.meetOurTeamConfig.rows <= 12)) &&
        data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 64;
    }

    function isValidTeamMember(data, memberId) {
      return data != null &&
        data.keys().hasAll([
          'teamMemberId', 'fullName', 'designation', 'introduction',
          'imageStoragePath', 'imageUrl', 'displayOrder', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'teamMemberId', 'fullName', 'designation', 'introduction',
          'imageStoragePath', 'imageUrl', 'thumbnailStoragePath', 'thumbnailUrl',
          'imageWidth', 'imageHeight', 'socialLinks', 'displayOrder', 'status',
          'createdAt', 'updatedAt', 'updatedBy', 'updatedByRole', 'updatedByEmail'
        ]) &&
        data.teamMemberId is string && data.teamMemberId == memberId &&
        data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120 &&
        data.designation is string && data.designation.size() >= 2 && data.designation.size() <= 140 &&
        data.introduction is string && data.introduction.size() >= 5 && data.introduction.size() <= 6000 &&
        data.imageStoragePath is string && data.imageStoragePath.size() > 0 && data.imageStoragePath.size() <= 400 &&
        data.imageUrl is string && data.imageUrl.size() > 0 && data.imageUrl.size() <= 400000 &&
        (!('thumbnailStoragePath' in data) || (data.thumbnailStoragePath is string && data.thumbnailStoragePath.size() <= 400)) &&
        (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 400000)) &&
        (!('imageWidth' in data) || (data.imageWidth is int && data.imageWidth > 0 && data.imageWidth <= 10000)) &&
        (!('imageHeight' in data) || (data.imageHeight is int && data.imageHeight > 0 && data.imageHeight <= 10000)) &&
        (!('socialLinks' in data) || data.socialLinks is map) &&
        (data.displayOrder is int || data.displayOrder is float) &&
        data.displayOrder >= 0 && data.displayOrder <= 9999 &&
        data.status in ['ACTIVE', 'INACTIVE'] &&
        data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 64;
    }

    match /websiteContent/{pageId} {
      allow get: if isValidId(pageId) && pageId == 'aboutUs';
      allow list: if isMasterAdmin() || canAccessCMSContent();
      allow create, update: if isValidId(pageId) && pageId == 'aboutUs' &&
        (isMasterAdmin() || canAccessCMSContent() || isValidAdminCMSData()) &&
        isValidAboutUsWebsiteContent(request.resource.data);
      allow delete: if isValidId(pageId) && (isMasterAdmin() || canAccessCMSContent());

      match /meetOurTeam/{teamMemberId} {
        allow get: if isValidId(teamMemberId) && (
          isMasterAdmin() ||
          canAccessCMSContent() ||
          (resource != null && resource.data.status == 'ACTIVE')
        );
        allow list: if isMasterAdmin() ||
          canAccessCMSContent() ||
          resource.data.status == 'ACTIVE';
        allow create: if isValidId(teamMemberId) &&
          pageId == 'aboutUs' &&
          (isMasterAdmin() || canAccessCMSContent() || isValidAdminCMSData()) &&
          isValidTeamMember(request.resource.data, teamMemberId);
        allow update: if isValidId(teamMemberId) &&
          pageId == 'aboutUs' &&
          (isMasterAdmin() || canAccessCMSContent() || isValidAdminCMSData()) &&
          isValidTeamMember(request.resource.data, teamMemberId) &&
          request.resource.data.teamMemberId == resource.data.teamMemberId &&
          request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isValidId(teamMemberId) &&
          pageId == 'aboutUs' &&
          (isMasterAdmin() || canAccessCMSContent() || isResourceAdminOwned());
      }
    }

    // =========================================================================
    // STRICT UID-SCOPED USER CART ISOLATION & LEGACY CART QUARANTINE
    // Path: users/{userId}/cart/{cartItemId}
    // Primary Owner Identifier: Firebase Authentication UID (NEVER agencyId)
    // =========================================================================

    function isAuthorisedCartAdmin() {
      return isAuthenticated() && (
        isMasterAdmin() ||
        (hasUserDoc(request.auth.uid) &&
          isApprovedUser() &&
          (currentUserData().role == 'ADMIN' || currentUserData().role == 'SUPER_ADMIN'))
      );
    }

    function isValidUserCartItem(data, expectedOwnerUid, expectedCartItemId) {
      return data != null &&
        data.keys().hasAll([
          'cartItemId', 'ownerUid', 'productId', 'productName', 'productCategory',
          'destinationId', 'selectedServiceDate', 'quantity', 'passengerConfig',
          'itemPayload', 'addedByUid', 'addedByRole', 'addedAt', 'updatedAt',
          'status', 'schemaVersion'
        ]) &&
        data.keys().hasOnly([
          'cartItemId', 'ownerUid', 'agencyId', 'productId', 'productName', 'productCategory',
          'destinationId', 'hubId', 'selectedServiceDate', 'quantity', 'passengerConfig',
          'selectedOptions', 'notes', 'itemPayload', 'addedByUid', 'addedByRole',
          'addedByName', 'addedByEmail', 'adminNote', 'addedAt', 'updatedAt',
          'status', 'schemaVersion'
        ]) &&
        data.cartItemId is string && data.cartItemId == expectedCartItemId &&
        data.ownerUid is string && data.ownerUid == expectedOwnerUid &&
        (!('agencyId' in data) || data.agencyId == null || (data.agencyId is string && data.agencyId.size() <= 128)) &&
        data.productId is string && data.productId.size() > 0 && data.productId.size() <= 128 &&
        data.productName is string && data.productName.size() > 0 && data.productName.size() <= 240 &&
        data.productCategory is string && data.productCategory.size() > 0 && data.productCategory.size() <= 80 &&
        data.destinationId is string && data.destinationId.size() > 0 && data.destinationId.size() <= 128 &&
        (!('hubId' in data) || data.hubId == null || (data.hubId is string && data.hubId.size() <= 128)) &&
        data.selectedServiceDate is string && data.selectedServiceDate.size() <= 32 &&
        (data.quantity is int || data.quantity is float) && data.quantity >= 1 && data.quantity <= 999 &&
        data.passengerConfig is map &&
        (!('selectedOptions' in data) || data.selectedOptions is map) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000)) &&
        data.itemPayload is map &&
        data.addedByUid is string && isValidId(data.addedByUid) &&
        data.addedByRole in ['B2B_AGENT', 'ADMIN'] &&
        (!('addedByName' in data) || (data.addedByName is string && data.addedByName.size() <= 160)) &&
        (!('addedByEmail' in data) || (data.addedByEmail is string && data.addedByEmail.size() <= 160)) &&
        (!('adminNote' in data) || (data.adminNote is string && data.adminNote.size() <= 1000)) &&
        data.addedAt is string && data.addedAt.size() > 0 && data.addedAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 64 &&
        data.status in ['ACTIVE', 'CONVERTED', 'REMOVED'] &&
        data.schemaVersion == 2;
    }

    function isValidQuarantinedLegacyCartItem(data, expectedRecordId) {
      return data != null &&
        data.keys().hasAll([
          'id', 'legacyItemId', 'sourceStorage', 'quarantineReason', 'status',
          'productId', 'productName', 'productCategory', 'rawItemPayload',
          'discoveredByUid', 'discoveredAt', 'schemaVersion'
        ]) &&
        data.keys().hasOnly([
          'id', 'legacyItemId', 'sourceStorage', 'quarantineReason', 'status',
          'productId', 'productName', 'productCategory', 'destinationId', 'rawItemPayload',
          'discoveredByUid', 'discoveredAt', 'assignedToUid', 'assignedToName',
          'assignedByUid', 'assignedAt', 'archivedByUid', 'archivedAt',
          'adminNotes', 'schemaVersion'
        ]) &&
        data.id is string && data.id == expectedRecordId &&
        data.legacyItemId is string && data.legacyItemId.size() > 0 && data.legacyItemId.size() <= 128 &&
        data.sourceStorage in ['LOCAL_STORAGE', 'SESSION_STORAGE', 'LEGACY_FIRESTORE'] &&
        data.quarantineReason in [
          'MISSING_OWNER_UID', 'AMBIGUOUS_SHARED_STORAGE', 'AGENCY_ONLY_OWNERSHIP', 'UNVERIFIED_OWNER_UID'
        ] &&
        data.status in ['QUARANTINED', 'ASSIGNED', 'ARCHIVED'] &&
        data.productId is string && data.productId.size() > 0 && data.productId.size() <= 128 &&
        data.productName is string && data.productName.size() > 0 && data.productName.size() <= 240 &&
        data.productCategory is string && data.productCategory.size() > 0 && data.productCategory.size() <= 80 &&
        (!('destinationId' in data) || (data.destinationId is string && data.destinationId.size() <= 128)) &&
        data.rawItemPayload is map &&
        data.discoveredByUid is string && data.discoveredByUid.size() > 0 && data.discoveredByUid.size() <= 128 &&
        data.discoveredAt is string && data.discoveredAt.size() > 0 && data.discoveredAt.size() <= 64 &&
        (!('assignedToUid' in data) || (data.assignedToUid is string && data.assignedToUid.size() <= 128)) &&
        (!('assignedToName' in data) || (data.assignedToName is string && data.assignedToName.size() <= 160)) &&
        (!('assignedByUid' in data) || (data.assignedByUid is string && data.assignedByUid.size() <= 128)) &&
        (!('assignedAt' in data) || (data.assignedAt is string && data.assignedAt.size() <= 64)) &&
        (!('archivedByUid' in data) || (data.archivedByUid is string && data.archivedByUid.size() <= 128)) &&
        (!('archivedAt' in data) || (data.archivedAt is string && data.archivedAt.size() <= 64)) &&
        (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 1000)) &&
        data.schemaVersion == 2;
    }

    match /users/{userId}/cart/{cartItemId} {
      // Strictly isolated by Firebase Auth UID (ownerUid == userId).
      // Agency ID is NEVER used to grant access across users.
      allow get: if isAuthenticated() && isValidId(userId) && isValidId(cartItemId) && isNotBuyer() && (
        (request.auth.uid == userId && isApprovedUser() && (resource == null || resource.data.ownerUid == request.auth.uid)) ||
        isAuthorisedCartAdmin()
      );

      allow list: if isAuthenticated() && isValidId(userId) && isNotBuyer() && (
        (request.auth.uid == userId && isApprovedUser() && resource.data.ownerUid == request.auth.uid) ||
        isAuthorisedCartAdmin()
      );

      allow create: if isAuthenticated() && isValidId(userId) && isValidId(cartItemId) && isNotBuyer() &&
        isValidUserCartItem(request.resource.data, userId, cartItemId) && (
          (
            isApprovedUser() &&
            request.auth.uid == userId &&
            request.resource.data.ownerUid == request.auth.uid &&
            request.resource.data.addedByUid == request.auth.uid &&
            request.resource.data.addedByRole == 'B2B_AGENT'
          ) ||
          (
            isAuthorisedCartAdmin() &&
            request.resource.data.ownerUid == userId &&
            request.resource.data.addedByUid == request.auth.uid &&
            request.resource.data.addedByRole == 'ADMIN' &&
            exists(/databases/$(database)/documents/users/$(userId))
          )
        );

      allow update: if isAuthenticated() && isValidId(userId) && isValidId(cartItemId) && isNotBuyer() &&
        isValidUserCartItem(request.resource.data, userId, cartItemId) &&
        request.resource.data.cartItemId == resource.data.cartItemId &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.ownerUid == userId &&
        request.resource.data.addedByUid == resource.data.addedByUid &&
        request.resource.data.addedByRole == resource.data.addedByRole &&
        request.resource.data.addedAt == resource.data.addedAt &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'quantity', 'selectedServiceDate', 'passengerConfig', 'selectedOptions',
          'itemPayload', 'notes', 'status', 'updatedAt', 'hubId', 'destinationId',
          'productCategory', 'productName', 'adminNote'
        ]) && (
          (isApprovedUser() && request.auth.uid == userId && resource.data.ownerUid == request.auth.uid) ||
          isAuthorisedCartAdmin()
        );

      allow delete: if isAuthenticated() && isValidId(userId) && isValidId(cartItemId) && isNotBuyer() && (
        (isApprovedUser() && request.auth.uid == userId && resource.data.ownerUid == request.auth.uid) ||
        isAuthorisedCartAdmin()
      );
    }

    match /quarantined_legacy_cart_items/{recordId} {
      // Only authorised Admins may read, list, update (assign/archive), or delete quarantined records.
      allow get: if isValidId(recordId) && isAuthorisedCartAdmin();
      allow list: if isAuthorisedCartAdmin();
      // Authenticated approved users may create initial QUARANTINED records during safe legacy purge;
      // they cannot read, modify, or delete quarantined items.
      allow create: if isAuthenticated() && isValidId(recordId) && isApprovedUser() &&
        isValidQuarantinedLegacyCartItem(request.resource.data, recordId) &&
        request.resource.data.status == 'QUARANTINED' &&
        (request.resource.data.discoveredByUid == request.auth.uid || isAuthorisedCartAdmin());
      allow update: if isValidId(recordId) && isAuthorisedCartAdmin() &&
        isValidQuarantinedLegacyCartItem(request.resource.data, recordId) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.discoveredAt == resource.data.discoveredAt;
      allow delete: if isValidId(recordId) && isAuthorisedCartAdmin();
    }
  }
}
